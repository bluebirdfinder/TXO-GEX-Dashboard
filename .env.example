# =================================================================
# TXO GEX Dashboard - Fubon Neo API Environment Template
# -----------------------------------------------------------------
# SECURITY WARNING: DO NOT COMMIT REAL KEYS TO GIT!
# Copy this file to '.env' locally and fill in your actual credentials.
# =================================================================

# Fubon Neo API Client Credentials (從富邦證券 API 開發者中心取得)
FUBON_API_KEY=YOUR_FUBON_API_KEY_HERE
FUBON_SECRET_KEY=OPTIONAL_OR_LEAVE_BLANK

# Brokerage Account Number or ID Number (身分證字號或帳號)
FUBON_ACCOUNT_NO=YOUR_ID_OR_ACCOUNT_NUMBER

# Electronic Certificate Configuration (電子簽署憑證檔路徑與密碼)
# 請將您的 PFX 憑證放置於本機安全資料夾，並在此填寫絕對路徑與密碼
FUBON_CERT_PATH=C:/Path/To/Your/Certificate.pfx
FUBON_CERT_PASS=YOUR_CERTIFICATE_PASSWORD_HERE

# Operation Mode Options (LIVE: 真實 API 串流 / SIMULATED: 模擬測試 / FALLBACK: 官方 API 備援)
FUBON_API_MODE=FALLBACK
