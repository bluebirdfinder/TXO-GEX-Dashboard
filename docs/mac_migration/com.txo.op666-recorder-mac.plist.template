<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.txo.op666-recorder-mac</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/AI/op666/run_op666_recorder.sh</string>
    <string>__HOME__/AI/txo-mac.env</string>
    <string>__HOME__/AI/op666/op666_recorder.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>TXO_PYTHON</key><string>__HOME__/AI/fubon-test/bin/python</string>
    <key>OP666_RECORD_DIR</key><string>__HOME__/AI/op666_record_mac</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HOME__/AI/op666_record_mac/launchd.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/AI/op666_record_mac/launchd.err.log</string>
</dict>
</plist>
