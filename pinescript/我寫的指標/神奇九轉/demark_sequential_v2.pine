// ╔══════════════════════════════════════════════════════════════════════╗
// ║          DeMark Sequential | 德馬克序列  (TD Sequential)             ║
// ║  Logic based on Tom DeMark's Sequential® methodology.               ║
// ║  Implements: Setup (9) → TDST → Countdown (13/R)                    ║
// ║  Features:                                                           ║
// ║   • Buy / Sell Setup with price-flip detection                       ║
// ║   • Setup Perfection marker (★)                                     ║
// ║   • TDST support / resistance lines                                  ║
// ║   • Non-consecutive Countdown (13 or R)                              ║
// ║   • 8 vs 5 Qualifier (optional, default off)                         ║
// ║   • Last vs 8 Qualifier (default on)                                 ║
// ║   • TDST Cancel Rule & Reverse Setup Cancel                          ║
// ║   • Recycle (R) when setup extends to recycle_n bars                 ║
// ║   • User-configurable Buy / Sell colors                              ║
// ║   • Alert conditions for Setup 9 and Countdown 13                    ║
// ╚══════════════════════════════════════════════════════════════════════╝
//@version=6
indicator("DeMark Sequential | 神奇九轉 V2", shorttitle="神奇九轉 V2",
         overlay=true, max_labels_count=500, max_lines_count=500)

// ══════════════════════════════════════════════════════════════════════
// ▌ SECTION 0 – INPUTS
// ══════════════════════════════════════════════════════════════════════
g1   = "🎨 Display 顯示設定"
g_buy_zone  = "⬇️ K棒下方顯示 (多頭行動區)"
g_sell_zone = "⬆️ K棒上方顯示 (空頭行動區)"
g_td = "📏 TDST 線條顏色"
g2   = "① Setup 設置階段"
g3   = "② Countdown 倒數階段"
g_f  = "🔍 初升段過濾器 (Filter for 1~3)"

// ── Display ──────────────────────────────────────────────────────────
show_seq   = input.bool(true, "Show Demark Sequential  顯示德馬克序列", group=g1)

// ── K棒下方 (多頭行動區/找買點) ───────────────────────────────────────
early_up_1 = input.color(#D1C4E9, "初升段試多單 1",          group=g_buy_zone)
early_up_2 = input.color(#b495e9, "初升段試多單 2",          group=g_buy_zone)
early_up_3 = input.color(#9071ee, "初升段試多單 3",          group=g_buy_zone)
b_col_7    = input.color(#FFEE58, "賣盤竭盡抄底 7",          group=g_buy_zone)
b_col_8    = input.color(#FFA726, "賣盤竭盡抄底 8",          group=g_buy_zone)
b_col_9    = input.color(#F48FB1, "賣盤竭盡抄底 9",          group=g_buy_zone)
b_col_13   = input.color(#FFEB3B, "賣盤竭盡抄底 13",         group=g_buy_zone)
b_col_R    = input.color(#f12521, "V 轉確立 R",          group=g_buy_zone)

// ── K棒上方 (空頭行動區/找賣點) ───────────────────────────────────────
early_dn_1 = input.color(#B3E5FC, "初跌段試空單 1",          group=g_sell_zone)
early_dn_2 = input.color(color.rgb(120, 186, 248), "初跌段試空單 2",          group=g_sell_zone)
early_dn_3 = input.color(color.rgb(57, 168, 241), "初跌段試空單 3",          group=g_sell_zone)
s_col_7    = input.color(color.rgb(15, 189, 151), "買盤竭盡減碼 7",          group=g_sell_zone)
s_col_8    = input.color(#4CAF50, "買盤竭盡減碼 8",          group=g_sell_zone)
s_col_9    = input.color(color.rgb(103, 241, 200), "買盤竭盡減碼 9",          group=g_sell_zone)
s_col_13   = input.color(#9af2f5, "買盤竭盡減碼 13",         group=g_sell_zone)
s_col_R    = input.color(#3fa6fa, "A 轉確立 R",          group=g_sell_zone)

// ── TDST 線條顏色 & 線型 ─────────────────────────────────────────────
buy_tdst_col   = input.color (color.new(#E53935, 30), "買方 TDST 顏色",  group=g_td)
buy_tdst_sty   = input.string("實線 ━━━━", "買方 TDST 線型",
                               options=["實線 ━━━━", "虛線 ╌╌╌╌", "點線 ┈┈┈┈"],
                               group=g_td)
sell_tdst_col  = input.color (color.new(#26A69A, 30), "賣方 TDST 顏色",  group=g_td)
sell_tdst_sty  = input.string("虛線 ╌╌╌╌", "賣方 TDST 線型",
                               options=["實線 ━━━━", "虛線 ╌╌╌╌", "點線 ┈┈┈┈"],
                               group=g_td)

// 線型字串 → Pine Script line_style 常數
f_line_style(s) =>
    switch s
        "實線 ━━━━" => line.style_solid
        "虛線 ╌╌╌╌" => line.style_dashed
        =>              line.style_dotted

buy_tdst_style  = f_line_style(buy_tdst_sty)
sell_tdst_style = f_line_style(sell_tdst_sty)

// ── 保留給 TDST 邏輯使用的基準顏色（不顯示於設定面板）──────────────────
buy_col  = b_col_9    // 買方基準色（供 TDST 等使用）
sell_col = s_col_9    // 賣方基準色

// ── Setup ─────────────────────────────────────────────────────────────
show_tdst  = input.bool(true,  "Show TDST Lines",        group=g2)
show_perf  = input.bool(true,  "Setup Perfection ★",    group=g2)

// ── Countdown ─────────────────────────────────────────────────────────
show_cd    = input.bool(true,  "Show Countdown 顯示倒數",    group=g3)
q_8v5      = input.bool(false, "8 vs 5 Qualifier",           group=g3)
q_lv8      = input.bool(true,  "Last vs 8 Qualifier",        group=g3)
tdst_rule  = input.bool(true,  "TDST Cancel Rule",           group=g3)
rev_rule   = input.bool(true,  "Reverse Setup Cancel",       group=g3)
use_recycle= input.bool(true,  "Enable Recycle (R)",          group=g3)
recycle_n  = input.int (22,    "Recycle Trigger (consecuti" +
                                "ve setup bars)", minval=9,   group=g3)

// ── Early Trend Filter (1~3) ──────────────────────────────────────────
show_early  = input.bool(true, "顯示 1~3 早期倒數 (搭配過濾)", group=g_f)
filter_mode = input.string("MACD 金/死叉 + AO 零軸之上/下", "過濾模式", 
                           options=["無過濾 (顯示所有1~3)", "MACD 金/死叉", "AO 零軸之上/下", "MACD 金/死叉 + AO 零軸之上/下"], 
                           group=g_f)

// ── Helpers ───────────────────────────────────────────────────────────
c_none = color.new(color.white, 100)   // fully transparent background


// ══════════════════════════════════════════════════════════════════════
// ▌ SECTION 1 – SETUP PHASE
// ══════════════════════════════════════════════════════════════════════
b_cond = close < close[4]
s_cond = close > close[4]

b_flip = b_cond and not b_cond[1]
s_flip = s_cond and not s_cond[1]

var int b_cnt = 0
var int s_cnt = 0

b_cnt := b_cond ? (b_flip ? 1 : b_cnt[1] > 0 ? b_cnt[1] + 1 : 0) : 0
s_cnt := s_cond ? (s_flip ? 1 : s_cnt[1] > 0 ? s_cnt[1] + 1 : 0) : 0

var float b_maxH = na
var float s_minL = na

b_maxH := b_cnt > 0 ? (b_cnt == 1 ? high : math.max(b_maxH[1], high)) : na
s_minL := s_cnt > 0 ? (s_cnt == 1 ? low  : math.min(s_minL[1], low))  : na

var float bl6 = na
var float bl7 = na
var float bl8 = na
var float sh6 = na
var float sh7 = na
var float sh8 = na

if b_cnt == 6
    bl6 := low
if b_cnt == 7
    bl7 := low
if b_cnt == 8
    bl8 := low
if s_cnt == 6
    sh6 := high
if s_cnt == 7
    sh7 := high
if s_cnt == 8
    sh8 := high

b_done = b_cnt == 9
s_done = s_cnt == 9

b_perf = show_perf and b_done and
         not na(bl6) and not na(bl7) and not na(bl8) and
         math.min(bl8, low)  < math.min(bl6, bl7)

s_perf = show_perf and s_done and
         not na(sh6) and not na(sh7) and not na(sh8) and
         math.max(sh8, high) > math.max(sh6, sh7)

// ══════════════════════════════════════════════════════════════════════
// ▌ SECTION 2 – TDST LINES
// ══════════════════════════════════════════════════════════════════════
// Only ONE line per direction kept at any time.

var line buy_tdst_line  = na
var line sell_tdst_line = na

if b_done and show_tdst
    if not na(buy_tdst_line)
        line.delete(buy_tdst_line)
    buy_tdst_line := line.new(bar_index - 8, nz(b_maxH, high),
                              bar_index,     nz(b_maxH, high),
                              color=buy_tdst_col, width=1,
                              style=buy_tdst_style, extend=extend.right)

if s_done and show_tdst
    if not na(sell_tdst_line)
        line.delete(sell_tdst_line)
    sell_tdst_line := line.new(bar_index - 8, nz(s_minL, low),
                               bar_index,     nz(s_minL, low),
                               color=sell_tdst_col, width=1,
                               style=sell_tdst_style, extend=extend.right)


// ══════════════════════════════════════════════════════════════════════
// ▌ SECTION 3 – COUNTDOWN PHASE
// ══════════════════════════════════════════════════════════════════════
var int   bc       = 0
var bool  bc_on    = false
var float bc_tdst  = na
var float bc_cl5   = na
var float bc_cl8   = na
var bool  bc_recyd = false

var int   sc       = 0
var bool  sc_on    = false
var float sc_tdst  = na
var float sc_cl5   = na
var float sc_cl8   = na
var bool  sc_recyd = false

bc_tdst_brk = bc_on and tdst_rule and not na(bc_tdst) and high > bc_tdst
sc_tdst_brk = sc_on and tdst_rule and not na(sc_tdst) and low  < sc_tdst
bc_rev_cxl  = bc_on and rev_rule  and s_done
sc_rev_cxl  = sc_on and rev_rule  and b_done

if bc_tdst_brk or bc_rev_cxl
    bc_on  := false
    bc     := 0
    bc_cl5 := na
    bc_cl8 := na

if sc_tdst_brk or sc_rev_cxl
    sc_on  := false
    sc     := 0
    sc_cl5 := na
    sc_cl8 := na

if b_done and not bc_on
    bc_on   := true
    bc      := 0
    bc_recyd:= false
    bc_tdst := nz(b_maxH, high)
    bc_cl5  := na
    bc_cl8  := na

if s_done and not sc_on
    sc_on   := true
    sc      := 0
    sc_recyd:= false
    sc_tdst := nz(s_minL, low)
    sc_cl5  := na
    sc_cl8  := na

if bc_on and use_recycle and b_cnt == recycle_n
    bc      := 0
    bc_recyd:= true
    bc_tdst := nz(b_maxH, high)
    bc_cl5  := na
    bc_cl8  := na

if sc_on and use_recycle and s_cnt == recycle_n
    sc      := 0
    sc_recyd:= true
    sc_tdst := nz(s_minL, low)
    sc_cl5  := na
    sc_cl8  := na

bc_bar = close <= low[2]
sc_bar = close >= high[2]

bool bc_fired = false

if bc_on and bc_bar and bc < 13 and not b_done
    if bc == 7 and q_8v5
        if low < nz(bc_cl5, high)
            bc       := 8
            bc_cl8   := close
            bc_fired := true
    else if bc == 12 and q_lv8
        if low <= nz(bc_cl8, high)
            bc       := 13
            bc_fired := true
    else if bc != 7 or not q_8v5
        bc       += 1
        bc_fired := true
        if bc == 5
            bc_cl5 := close
        if bc == 8
            bc_cl8 := close

bool sc_fired = false

if sc_on and sc_bar and sc < 13 and not s_done
    if sc == 7 and q_8v5
        if high > nz(sc_cl5, low)
            sc       := 8
            sc_cl8   := close
            sc_fired := true
    else if sc == 12 and q_lv8
        if high >= nz(sc_cl8, low)
            sc       := 13
            sc_fired := true
    else if sc != 7 or not q_8v5
        sc       += 1
        sc_fired := true
        if sc == 5
            sc_cl5 := close
        if sc == 8
            sc_cl8 := close

bc_comp = bc_on and bc == 13
sc_comp = sc_on and sc == 13

if bc_comp
    bc_on := false
if sc_comp
    sc_on := false

// ══════════════════════════════════════════════════════════════════════
// ▌ SECTION 4 – ALERT CONDITIONS
// ══════════════════════════════════════════════════════════════════════

alertcondition(b_done,  "Buy Setup 9 完成",       "TD Seq ▲: Buy Setup 9 completed – potential reversal")
alertcondition(s_done,  "Sell Setup 9 完成",      "TD Seq ▼: Sell Setup 9 completed – potential reversal")
alertcondition(bc_comp, "Buy Countdown 13 完成",  "TD Seq ▲▲: Buy Countdown 13 – high-confidence reversal")
alertcondition(sc_comp, "Sell Countdown 13 完成", "TD Seq ▼▼: Sell Countdown 13 – high-confidence reversal")

// ══════════════════════════════════════════════════════════════════════
// ▌ SECTION 4.5 – FILTERS FOR EARLY COUNTS (1~3)
// ══════════════════════════════════════════════════════════════════════
// MACD (12, 26, 9)
macd_fast = ta.ema(close, 12)
macd_slow = ta.ema(close, 26)
macd_val  = macd_fast - macd_slow
macd_sig  = ta.ema(macd_val, 9)
macd_bull = macd_val > macd_sig
macd_bear = macd_val < macd_sig

// AO (5, 34)
ao_val  = ta.sma(hl2, 5) - ta.sma(hl2, 34)
ao_bull = ao_val > 0
ao_bear = ao_val < 0

// b_cnt = Buy Setup (價格下跌, 醞釀潛在底部). 過濾看空頭動能延續
b_filter_pass = filter_mode == "無過濾 (顯示所有1~3)" or (filter_mode == "MACD 金/死叉" and macd_bear) or (filter_mode == "AO 零軸之上/下" and ao_bear) or (filter_mode == "MACD 金/死叉 + AO 零軸之上/下" and macd_bear and ao_bear)

// s_cnt = Sell Setup (價格上漲, 形成初升段). 過濾看多頭動能延續
s_filter_pass = filter_mode == "無過濾 (顯示所有1~3)" or (filter_mode == "MACD 金/死叉" and macd_bull) or (filter_mode == "AO 零軸之上/下" and ao_bull) or (filter_mode == "MACD 金/死叉 + AO 零軸之上/下" and macd_bull and ao_bull)

// ══════════════════════════════════════════════════════════════════════
// ▌ SECTION 5 – SHAPES (plotshape / plotchar)
// ══════════════════════════════════════════════════════════════════════
// All shapes use location.belowbar (Buy) or location.abovebar (Sell).
// Multiple plotshape/plotchar on the same bar with the same location
// are stacked vertically by TradingView → ★ always appears directly
// below/above the ⑨ circle, regardless of K-bar height or zoom level.
// ──────────────────────────────────────────────────────────────────────

// ── Buy signals  (below bar → location.belowbar) ──────────────────────
// 🔥 由於視覺邏輯翻轉，初升段做多 (s_cnt) 將繪製於 K棒下方
plotshape(show_seq and show_early and s_cnt == 1 and s_filter_pass,
          title="Early Up 1",         style=shape.circle,
          location=location.belowbar, color=early_up_1,
          text="1",   textcolor=early_up_1,  size=size.auto)

plotshape(show_seq and show_early and s_cnt == 2 and s_filter_pass,
          title="Early Up 2",         style=shape.circle,
          location=location.belowbar, color=early_up_2,
          text="2",   textcolor=early_up_2,  size=size.auto)

plotshape(show_seq and show_early and s_cnt == 3 and s_filter_pass,
          title="Early Up 3",         style=shape.circle,
          location=location.belowbar, color=early_up_3,
          text="3",   textcolor=early_up_3,  size=size.auto)

plotshape(show_seq and b_cnt == 7,
          title="Buy 7",              style=shape.circle,
          location=location.belowbar, color=b_col_7,
          text="7",   textcolor=b_col_7,  size=size.auto)

plotshape(show_seq and b_cnt == 8,
          title="Buy 8",              style=shape.circle,
          location=location.belowbar, color=b_col_8,
          text="8",   textcolor=b_col_8,  size=size.auto)

plotshape(show_seq and b_done and not b_perf,
          title="Buy 9",              style=shape.circle,
          location=location.belowbar, color=b_col_9,
          text="9",   textcolor=b_col_9,  size=size.auto)

// Buy 9★: 星號放進圓點文字，永遠跟 9 在一起
plotshape(show_seq and b_done and b_perf,
          title="Buy 9 (Perf)",       style=shape.circle,
          location=location.belowbar, color=b_col_9,
          text="9★",  textcolor=b_col_9,  size=size.auto)

plotshape(show_seq and show_cd and bc_comp and not bc_recyd,
          title="Buy 13",             style=shape.circle,
          location=location.belowbar, color=b_col_13,
          text="13",  textcolor=b_col_13,  size=size.auto)

plotshape(show_seq and show_cd and bc_comp and bc_recyd,
          title="Buy R (Recycle)",    style=shape.circle,
          location=location.belowbar, color=b_col_R,
          text="R",   textcolor=b_col_R,   size=size.auto)

// ── Sell signals  (above bar → location.abovebar) ─────────────────────
// 🔥 由於視覺邏輯翻轉，初跌段做空 (b_cnt) 將繪製於 K棒上方
plotshape(show_seq and show_early and b_cnt == 1 and b_filter_pass,
          title="Early Down 1",       style=shape.circle,
          location=location.abovebar, color=early_dn_1,
          text="1",   textcolor=early_dn_1, size=size.auto)

plotshape(show_seq and show_early and b_cnt == 2 and b_filter_pass,
          title="Early Down 2",       style=shape.circle,
          location=location.abovebar, color=early_dn_2,
          text="2",   textcolor=early_dn_2, size=size.auto)

plotshape(show_seq and show_early and b_cnt == 3 and b_filter_pass,
          title="Early Down 3",       style=shape.circle,
          location=location.abovebar, color=early_dn_3,
          text="3",   textcolor=early_dn_3, size=size.auto)

plotshape(show_seq and s_cnt == 7,
          title="Sell 7",             style=shape.circle,
          location=location.abovebar, color=s_col_7,
          text="7",   textcolor=s_col_7, size=size.auto)

plotshape(show_seq and s_cnt == 8,
          title="Sell 8",             style=shape.circle,
          location=location.abovebar, color=s_col_8,
          text="8",   textcolor=s_col_8, size=size.auto)

plotshape(show_seq and s_done and not s_perf,
          title="Sell 9",             style=shape.circle,
          location=location.abovebar, color=s_col_9,
          text="9",   textcolor=s_col_9, size=size.auto)

// Sell 9★: 星號放進圓點文字，永遠跟 9 在一起
plotshape(show_seq and s_done and s_perf,
          title="Sell 9 (Perf)",      style=shape.circle,
          location=location.abovebar, color=s_col_9,
          text="9★",  textcolor=s_col_9, size=size.auto)

plotshape(show_seq and show_cd and sc_comp and not sc_recyd,
          title="Sell 13",            style=shape.circle,
          location=location.abovebar, color=s_col_13,
          text="13",  textcolor=s_col_13, size=size.auto)

plotshape(show_seq and show_cd and sc_comp and sc_recyd,
          title="Sell R (Recycle)",   style=shape.circle,
          location=location.abovebar, color=s_col_R,
          text="R",   textcolor=s_col_R,  size=size.auto)
