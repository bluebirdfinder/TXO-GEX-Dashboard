//@version=6
indicator("J Indicator Advanced - Super MACD", "JJ_MACD", timeframe = "", timeframe_gaps = true)

// ================= 1. 主 MACD 參數（決定柱子高度） =================
grp_main = "主 MACD（決定柱子高度）"
srcMain  = input.source(close, "Source", group=grp_main)
fastMain = input.int(12, "Fast", 1, group=grp_main)
slowMain = input.int(26, "Slow", 1, group=grp_main)
sigMain  = input.int(9,  "Signal", 1, group=grp_main)

// ================= 2. ★ 副 MACD 參數（決定柱子顏色，快一步翻紅！） =================
grp_color_src = "★ 副 MACD（決定柱子顏色）—— JJ 獨門假設"
useDualMacd = input.bool(true, "啟用雙層 MACD 判色 (JJ猜測)", group=grp_color_src,
  tooltip="打勾：用副MACD（更靈敏）決定顏色，可在主MACD仍在水下時提早亮紅燈。\n取消：使用標準單層 MACD 判色。")
fastSub  = input.int(3,  "副MACD Fast",   1, group=grp_color_src)
slowSub  = input.int(15, "副MACD Slow",   1, group=grp_color_src)
sigSub   = input.int(5,  "副MACD Signal", 1, group=grp_color_src)

// ================= 3. 顏色設定（紅藍藍綠） =================
grp_color = "顏色設定"
color_up_pos   = input.color(#FF0000, "① 向上 + 水上 (紅)", group=grp_color)
color_down_pos = input.color(#0055FF, "② 向下 + 水上 (藍)", group=grp_color)
color_up_neg   = input.color(#0055FF, "③ 向上 + 水下 (藍)", group=grp_color)
color_down_neg = input.color(#00CC00, "④ 向下 + 水下 (綠)", group=grp_color)
color_macd_line = input.color(color.white,  "MACD 快線", group=grp_color)
color_sig_line  = input.color(color.yellow, "Signal 慢線", group=grp_color)

// ================= 4. 計算主 MACD（柱子高度） =================
maFast_main = ta.ema(srcMain, fastMain)
maSlow_main = ta.ema(srcMain, slowMain)
macd_main   = maFast_main - maSlow_main
signal_main = ta.ema(macd_main, sigMain)
hist_main   = macd_main - signal_main

// ================= 5. 計算副 MACD（顏色來源） =================
maFast_sub = ta.ema(srcMain, fastSub)
maSlow_sub = ta.ema(srcMain, slowSub)
macd_sub   = maFast_sub - maSlow_sub
signal_sub = ta.ema(macd_sub, sigSub)
hist_sub   = macd_sub - signal_sub

// ★ 用副 MACD 判色時：可能在主 MACD 仍為負值時，副 MACD 已轉正
// 這就是「水下出現紅色柱體」的底層機制！
// ★ 關鍵：用 macd_sub > 0（快線穿越慢線）而非 hist_sub > 0（柱高穿零軸）
// macd_sub > 0 觸發更早，能在主MACD仍負值時就提早變紅！
bool color_isUp = useDualMacd ? (macd_sub > 0) : (hist_main > 0)
bool color_momentum = useDualMacd ? (hist_sub > hist_sub[1]) : (hist_main > hist_main[1])

color hColor = color_isUp ?
  (color_momentum ? color_up_pos : color_down_pos) :
  (color_momentum ? color_up_neg : color_down_neg)

// ================= 6. 畫面繪製 =================
hline(0, "Zero", #787b8680)
plot(hist_main, "Histogram", hColor, style = plot.style_columns)  // 高度用主MACD，顏色用副MACD
plot(macd_main,   "MACD 快線",  color=color_macd_line, linewidth=2)
plot(signal_main, "Signal 慢線", color=color_sig_line,  linewidth=2)

alertcondition(hist_main[1] <= 0 and hist_main > 0, "MACD 突破零軸", "MACD 突破零軸向上")
alertcondition(hist_main[1] >= 0 and hist_main < 0, "MACD 跌破零軸", "MACD 跌破零軸向下")
