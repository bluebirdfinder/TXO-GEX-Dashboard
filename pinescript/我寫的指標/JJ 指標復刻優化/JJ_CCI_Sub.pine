//@version=6
indicator("J Indicator Advanced - Super CCI", format=format.price, precision=2, timeframe="", timeframe_gaps=true)

// ================= 1. 使用者輸入參數區 =================
cciGrp = "CCI 原始設定"
length = input.int(20, minval=1, title="Length", group=cciGrp, tooltip="預設20")
src    = input.source(hlc3, "Source", group=cciGrp)

colorGrp = "點位顏色與外觀"
color_main = input.color(color.yellow, "CCI 主線顏色", group=colorGrp)
color_b200 = input.color(#FF0000, "-200 買點顏色", group=colorGrp)
color_b100 = input.color(#FF8080, "-100 買點顏色", group=colorGrp)
color_s100 = input.color(#00FF00, "+100 賣點顏色", group=colorGrp)
color_s200 = input.color(#008000, "+200 賣點顏色", group=colorGrp)

macdGrp = "MACD 過濾器設定 (防鈍化)"
useMacdFilter = input.bool(false, "啟用 MACD 動能輔助確認", group=macdGrp, tooltip="打勾後，只有在 MACD 動能同步轉強/轉弱時才顯示買賣點，可大幅減少 CCI 鈍化時的假訊號。")
fastLenInput = input.int(12, "Fast length", group=macdGrp)
slowLenInput = input.int(26, "Slow length", group=macdGrp)
sigLenInput  = input.int(9,  "Signal length", group=macdGrp)

// ================= 2. 算式運算區 =================
cci_ma = ta.sma(src, length)
cci = (src - cci_ma) / (0.015 * ta.dev(src, length))

mac_fast = ta.ema(close, fastLenInput)
mac_slow = ta.ema(close, slowLenInput)
macd_val = mac_fast - mac_slow
mac_sig  = ta.ema(macd_val, sigLenInput)
hist     = macd_val - mac_sig

// ================= 3. 觸發條件判斷 =================
// MACD 動能判定 (可透過設定面板開關)
macd_buy_cond  = (hist > hist[1])
macd_sell_cond = (hist < hist[1])

// --- 紅色系買點 (跌深搶反彈) ---
// 買點1：由下往上穿過 -200
rule_buy_200 = ta.crossover(cci, -200) and (not useMacdFilter or macd_buy_cond)

// 買點2：由下往上穿過 -100 
rule_buy_100 = ta.crossover(cci, -100) and (not useMacdFilter or macd_buy_cond)

// --- 綠色系賣點 (高檔過熱區) ---
// 賣點1：由下往上穿過 +100
rule_sell_100 = ta.crossover(cci, 100) and (not useMacdFilter or macd_sell_cond)

// 賣點2：由下往上穿過 +200
rule_sell_200 = ta.crossover(cci, 200) // 碰到 +200 屬於極端現象，為了安全，即使開啟濾網也建議優先亮燈



// ================= 4. 畫面繪製 =================
plot(cci, "Super CCI 主線", color=color_main, linewidth=2)

// 退回使用經典 hline，並使用純色票以避開 TradingView 樣式卡死 Bug，讓您能在樣式表自由調色
hline(200,  "+200 超買區", color=#808080, linestyle=hline.style_dashed)
band1 = hline(100, "Upper Band (+100)", color=#787B86, linestyle=hline.style_dashed)
hline(0, "Middle Band (0)", color=#808080, linestyle=hline.style_dotted)
band0 = hline(-100, "Lower Band (-100)", color=#787B86, linestyle=hline.style_dashed)
hline(-200, "-200 超賣區", color=#808080, linestyle=hline.style_dashed)
fill(band1, band0, color=color.rgb(33, 150, 243, 90), title="Background")

plotshape(rule_buy_200 ? -200 : na, title="-200 買點", style=shape.circle, location=location.absolute, color=color_b200, size=size.small)
plotshape(rule_buy_100 ? -100 : na, title="-100 買點", style=shape.circle, location=location.absolute, color=color_b100, size=size.small)
plotshape(rule_sell_100 ? 100 : na, title="+100 賣點", style=shape.circle, location=location.absolute, color=color_s100, size=size.small)
plotshape(rule_sell_200 ? 200 : na, title="+200 賣點", style=shape.circle, location=location.absolute, color=color_s200, size=size.small)
