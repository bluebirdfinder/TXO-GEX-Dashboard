//@version=6
indicator("5K Strategy Master V5", shorttitle="5K戰法 V5", overlay=true, max_labels_count=500)

// ==============================================================================
// 1. 參數設定 (Inputs)
// ==============================================================================
grp_auto = "智能模式 (Smart Mode)"
use_auto_params = input.bool(true, title="啟用智能商品辨識 (Auto-Detect Parameters)", group=grp_auto, tooltip="開啟時，自動辨識圖表商品並覆寫最佳化的回溯區間、ATR乘數與風報比。")

grp_momentum = "動能過濾與極值 (手動設定 Manual)"
lookback_bars = input.int(48, title="回溯區間 (Lookback Bars, 48=4H)", group=grp_momentum, tooltip="手動模式下尋找局部最高/最低點的範圍\n✅ 股指期貨（台指/那指/標普/道瓊）：48~60根\n✅ 全天交易商品（黃金/原油/外匯）：72~96根")
atr_len = input.int(5, title="ATR 週期 (ATR Length)", group=grp_momentum, tooltip="計算波動幅度的週期\n✅ 平衡市場：5根（預設）\n⚠️ 趨勢市：可調至 8~10 根更穩定")
atr_mult = input.float(1.5, title="急殺/急拉 ATR 乘數", group=grp_momentum, step=0.1, tooltip="手動模式下：波動需多大才算急殺/急拉，越大訊號越少但越精\n\n指數期貨\n✅ 台指/富台/標普/道瓊：1.5~2.0\n✅ 那指/羅素：1.5~2.0\n⚠️ 日經/德指：2.0~2.5\n❌ 恆生：謹慎，政策風險大\n\n原物料\n✅ 黃金/銅：1.5~2.0（趨勢佳）\n✅ 原油：1.5~2.0\n⚠️ 白銀：2.0~2.5（每跳$5，風險大）\n⚠️ 農產品（黃豆/玉米/小麥）：1.5~2.0\n❌ 天然氣：2.5~3.0，謹慎\n\n外匯期貨\n⚠️ 歐元/英鎊/日幣：1.0~1.5\n❌ 澳幣/加幣：波動太小，訊號難觸發")
setup_age_limit = input.int(10, title="防雙刷壓制 (Setup Age Limit)", group=grp_momentum, tooltip="V4 新增：當反向訊號發生時，若距離上一個同向未進場 Setup 的 K 棒數小於此值，則壓制舊訊號，防止震盪雙刷。\n\n智能模式(Auto)下會自動依時框調整，手動模式下以此設定為準。\n\n📊 各時框建議值：\n⏱ 1分K：20根（=20分鐘緩衝）\n⏱ 3分K：15根（=45分鐘）\n⏱ 5分K：12根（=1小時）\n⏱ 15分K：10根（預設）\n⏱ 30分K：8根\n⏱ 1H K：6根（=6小時）\n⏱ 4H K：4根（=16小時）\n⏱ 日K：3根\n\n📌 商品差異調整：\n✅ 黃金(GC/MGC)：比預設稍低（趨勢性強，少壓制）\n✅ BTC：比預設稍高（假突破多）\n✅ 外匯(6E/6B)：接近預設（波動緩）\n⚠️ 天然氣(NG)：建議拉高（行情反覆）")

grp_entry = "進場微調 (Entry Settings)"
trade_dir = input.string("Both", title="交易方向 (Trade Direction)", options=["Both", "Long Only", "Short Only"], group=grp_entry, tooltip="過濾不想要的方向\n✅ 大漲中後期：選 Long Only\n✅ 高空後期：選 Short Only\n✅ 平衡市場：選 Both\nℹ️ 啟用 17/88MA 過濾器時，此選項與MA方向雙重篩選")
buffer_ticks = input.int(1, title="突破緩衝 (Buffer Ticks)", group=grp_entry, tooltip="突破極值時的額外確認空間\n✅ 股指/多數商品：1 tick（預設）\n⚠️ 外匯期貨：可調至 2 tick\nℹ️ 數字越大越不易被假突破，但進場會稍慢")

grp_exit = "停利設定 (手動設定 Manual)"
rr_ratio = input.float(1.5, title="快速停利風報比", group=grp_exit, step=0.1, tooltip="手動模式下：目標價距進場價的倍數，1.5 = 獲利是停損的 1.5 倍\n\n建議\n✅ 趨勢性強商品（黃金/銅/那指）：2.0，讓獲利空間更大\n✅ 原油：1.5~2.0 交替使用\n⚠️ 盤整商品（外匯/農產品）：維持 1.5，快進快出\n❌ 天然氣/恆生：不建議使用此指標")

grp_trend = "均線趨勢過濾 (Trend Filter)"
use_trend_filter = input.bool(true, title="啟用均線趨勢過濾", group=grp_trend, tooltip="啟用後，17MA > 88MA 時僅允許做多，反之僅允許做空")
ma_fast_len = input.int(17, title="快速均線長度 (Fast MA)", group=grp_trend)
ma_slow_len = input.int(88, title="慢速均線長度 (Slow MA)", group=grp_trend)
col_ma_fast = input.color(color.yellow, title="快速均線顏色", group=grp_trend)
col_ma_slow = input.color(color.fuchsia, title="慢速均線顏色", group=grp_trend)
show_ma = input.bool(true, title="顯示均線於圖表上", group=grp_trend)

grp_visual = "視覺顯示 (Visual Settings)"
show_sl = input.bool(true, title="顯示停損線 (Stop Loss)", group=grp_visual, tooltip="開啟時，會在持倉期間顯示防守停損位置的水平線")
show_tp = input.bool(false, title="顯示目標價線 (First Target)", group=grp_visual, tooltip="開啟時，會在持倉期間顯示預期達標(風報比)的獲利位置")
show_base = input.bool(false, title="顯示極值基準線 (Base Lines)", group=grp_visual, tooltip="開啟時，會在等待進場時顯示目前監控突破的最高/最低點水平線")
show_table = input.bool(true, title="顯示 Dashboard 面板", group=grp_visual, tooltip="顯示目前的狀態與 ATR 等數據面板")
panel_pos_str = input.string("Middle Right", title="面板位置 (Panel Position)", options=["Top Right", "Middle Right", "Bottom Right", "Bottom Left", "Top Left"], group=grp_visual)
panel_size_str = input.string("Small", title="面板文字大小 (Text Size)", options=["Tiny", "Small", "Normal"], group=grp_visual)

grp_tp_tf = "停利時框設定 (TP Timeframe) V5"
use_auto_tp_tf = input.bool(true, title="自動適應停利時框 (Auto TP Timeframe)",
    group=grp_tp_tf,
    tooltip="開啟時，停利 MACD 時框依圖表時框自動縮放：\n5分K→1分K / 30分K→5分K / 1H→15分K / 4H→1H / 日K→4H\n\n這修正了 V4.1 的核心問題：\n✅ 歷史回測不再出現因數據缺失造成的假性抱波段\n✅ 實盤停利行為與歷史圖表一致\n\n關閉時改用下方手動指定的時框。")

manual_tp_tf = input.string("1", title="手動停利時框 (Manual TP Timeframe)",
    options=["1","3","5","15","30","60","240","D"],
    group=grp_tp_tf,
    tooltip="關閉自動模式時生效。\n1=1分K, 3=3分K, 5=5分K, 15=15分K, 30=30分K, 60=1H, 240=4H, D=日K")

grp_sl_protect = "停損保護設定 (Stop Loss Protection) V5"

use_be_stop = input.bool(true, title="啟用保本停損 (Breakeven Stop)",
    group=grp_sl_protect,
    tooltip="開啟後，當帳面獲利達到「停損距離 × 保本門檻」時，停損自動移至進場成本，確保此單不虧損。\n\n移動時會同步發送 TG 通知，請手動在交易所更新停損掛單位置。\n\n智能模式下門檻依商品自動設定：\n⚡ 高波動（BTC/NG/HSI）：1.5 倍\n📈 趨勢型（黃金/外匯/原油）：0.8 倍\n📊 其他（台指/那指/標普）：1.0 倍")

manual_be_trigger = input.float(1.0, title="手動保本觸發門檻 (倍停損距離)",
    step=0.1, minval=0.3, maxval=3.0,
    group=grp_sl_protect,
    tooltip="關閉智能模式時生效。獲利達停損距離的幾倍時觸發保本。\n建議：0.8~1.5 之間，依商品波動率調整。")

use_trailing_stop = input.bool(true, title="啟用追蹤停損 (Trailing Stop)",
    group=grp_sl_protect,
    tooltip="保本後，停損線自動向有利方向追蹤，鎖住更多浮動盈利。\n\n⚠️ 在 1/3/5 分 K 時框下，無論此設定為何，追蹤停損自動停用（MACD 停利已足夠）。\n\n移動幅度達 0.5 倍 ATR 時發送 TG 通知，請手動更新交易所停損掛單。")

manual_trail_atr_mult = input.float(1.5, title="手動追蹤停損 ATR 乘數",
    step=0.1, minval=0.5, maxval=5.0,
    group=grp_sl_protect,
    tooltip="關閉智能模式時生效。追蹤停損設在最近高點（做多）或低點（做空）的幾倍 ATR 處。\n數值越小追蹤越緊（容易被洗出），越大越鬆（保護較少）。\n智能模式依時框自動設定：15/30分K=1.5，1H=2.0，4H=2.0，日K=2.5。")

grp_macd = "MACD 停利參數 (MTF MACD)"
macd_fast = input.int(12, title="MACD 快線", group=grp_macd)
macd_slow = input.int(26, title="MACD 慢線", group=grp_macd)
macd_signal = input.int(9, title="MACD 訊號線", group=grp_macd)

grp_colors = "顏色設定 (Color Settings)"
col_long_entry = input.color(color.red, title="做多進場箭頭顏色 (Long Entry)", group=grp_colors, tooltip="設定買入箭頭(▲)的顏色")
col_short_entry = input.color(color.green, title="做空進場箭頭顏色 (Short Entry)", group=grp_colors, tooltip="設定放空箭頭(▼)的顏色")
col_long_exit = input.color(color.yellow, title="做多出場符號顏色 (Long Exit)", group=grp_colors, tooltip="設定多單出場(＄/SL)的顏色")
col_short_exit = input.color(color.yellow, title="做空出場符號顏色 (Short Exit)", group=grp_colors, tooltip="設定空單出場(＄/SL)的顏色")
col_sl_line = input.color(color.new(#ff82b2, 0), title="停損線顏色 (Stop Loss Line)", group=grp_colors, tooltip="設定停損水平線的顏色與透明度")
col_tp_line = input.color(color.new(#4dd0e1, 0), title="目標價線顏色 (Target Line)", group=grp_colors, tooltip="設定目標價水平線的顏色與透明度")
col_base_line = input.color(color.new(color.gray, 70), title="極值基準線顏色 (Base Line)", group=grp_colors, tooltip="設定等待突破的基準線顏色與透明度")

grp_alerts = "警報與通知 (Alerts & Telegram) V5"
string dummy_alert_setting = input.string("請參考 Tooltip 設定", title="Telegram Webhook 設定說明", group=grp_alerts, tooltip="若要連動 Telegram，請在建立警報時：\n1. 條件選『任何 alert() 函數調用』\n2. 勾選『Webhook URL』\n3. 填入以下專屬 GAS 網址：\nhttps://script.google.com/macros/s/AKfycbzTZSzOQIij57h7a1Y2SHZDfgPtvLLCAyDKXHCoADvm5FFojIdcYdQQ-gKjOcUcWYv4LA/exec\n\n📌 【5K戰法 標配時區建議】\n✅ 核心主力 (台指/黃金/NQ)：開 1H + 4H + 日K\n✅ 農產品/基本金屬：開 4H + 日K\n✅ 軟性商品 (糖/棉花/橡膠)：只開 日K\n✅ 個股期貨 (台積/聯電)：開 1H + 日K (30分以下雜訊多建議關閉)")

// ==============================================================================
// 1.5 智能商品辨識邏輯 (Auto-Detect Logic)
// ==============================================================================
string r = syminfo.root
string asset_class = "Unknown"
float auto_atr_mult = 1.5
float auto_rr_ratio = 1.5
int auto_lookback = 48

// Indices
if array.includes(array.from("TX", "MTX", "TWN"), r)
    asset_class := "Taiwan Index (TX/TWN)"
    auto_atr_mult := 1.5, auto_rr_ratio := 1.5, auto_lookback := 48
else if array.includes(array.from("ES", "MES", "YM", "MYM"), r)
    asset_class := "US Index (Stable)"
    auto_atr_mult := 1.5, auto_rr_ratio := 1.5, auto_lookback := 48
else if array.includes(array.from("NQ", "MNQ", "RTY", "M2K"), r)
    asset_class := "US Index (Volatile)"
    auto_atr_mult := 2.0, auto_rr_ratio := 2.0, auto_lookback := 48
else if array.includes(array.from("NKD", "MNI", "NK225", "NK225M", "NK225MC", "FDAX", "FDXM"), r)
    asset_class := "Intl Index (High Vol)"
    auto_atr_mult := 2.2, auto_rr_ratio := 2.0, auto_lookback := 48
else if array.includes(array.from("HSI", "HHI", "MHI", "MCH"), r)
    asset_class := "Hang Seng"
    auto_atr_mult := 2.5, auto_rr_ratio := 2.0, auto_lookback := 48
    
// Commodities
else if array.includes(array.from("GC", "MGC", "HG", "QC", "MHG"), r)
    asset_class := "Metals (Trend)"
    auto_atr_mult := 1.5, auto_rr_ratio := 2.0, auto_lookback := 72
else if array.includes(array.from("SI", "SIL"), r)
    asset_class := "Silver (High Vol)"
    auto_atr_mult := 2.5, auto_rr_ratio := 2.0, auto_lookback := 72
else if array.includes(array.from("PL", "MPL", "PA"), r)
    asset_class := "Platinum/Palladium (High Vol)"
    auto_atr_mult := 2.5, auto_rr_ratio := 2.0, auto_lookback := 72
else if array.includes(array.from("CL", "MCL", "QM"), r)
    asset_class := "Crude Oil"
    auto_atr_mult := 2.0, auto_rr_ratio := 1.5, auto_lookback := 72
else if array.includes(array.from("NG", "QG", "MNG"), r)
    asset_class := "Natural Gas"
    auto_atr_mult := 3.0, auto_rr_ratio := 2.0, auto_lookback := 72
else if array.includes(array.from("ZS", "ZC", "ZW", "ZL"), r)
    asset_class := "Agriculture"
    auto_atr_mult := 1.5, auto_rr_ratio := 1.5, auto_lookback := 48
else if array.includes(array.from("CT"), r)
    asset_class := "Cotton"
    auto_atr_mult := 2.0, auto_rr_ratio := 2.0, auto_lookback := 48
    
// Forex
else if array.includes(array.from("6E", "M6E", "6A", "6C", "DX"), r)
    asset_class := "Forex (Low Vol)"
    auto_atr_mult := 1.2, auto_rr_ratio := 1.5, auto_lookback := 72
else if array.includes(array.from("6B", "M6B", "6J", "XJK", "JPYUSD", "USDJPY"), r)
    asset_class := "Forex (Mid Vol)"
    auto_atr_mult := 1.5, auto_rr_ratio := 1.5, auto_lookback := 72

// Crypto
else if syminfo.root == "BTC"
    asset_class := "Crypto (BTC)"
    auto_atr_mult := 2.5, auto_rr_ratio := 2.0, auto_lookback := 48
else if syminfo.type == "crypto"
    asset_class := "Crypto (Alt)"
    auto_atr_mult := 2.0, auto_rr_ratio := 2.0, auto_lookback := 48

bool is_auto_active = use_auto_params and asset_class != "Unknown"
final_atr_mult = is_auto_active ? auto_atr_mult : atr_mult
final_rr_ratio = is_auto_active ? auto_rr_ratio : rr_ratio
final_lookback = is_auto_active ? auto_lookback : lookback_bars

// [V4.1 新增] 依時框自動計算防雙刷壓制數值 (智能模式下生效)
int auto_setup_age = timeframe.period == "1" ? 20 : timeframe.period == "3" ? 15 : timeframe.period == "5" ? 12 : timeframe.period == "15" ? 10 : timeframe.period == "30" ? 8 : timeframe.period == "60" ? 6 : timeframe.period == "240" ? 4 : 3
int final_setup_age_limit = is_auto_active ? auto_setup_age : setup_age_limit

// [V5] Helper functions — 使用 if/else 確保 Pine Script v6 相容性
f_calc_be_trigger() =>
    _r = syminfo.root
    float _v = 1.0
    if array.includes(array.from("BTC","ETH","SOL","XRP"), _r)
        _v := 1.5
    else if array.includes(array.from("NG","QG","MNG"), _r)
        _v := 1.5
    else if array.includes(array.from("HSI","HHI","MHI","MCH"), _r)
        _v := 1.5
    else if array.includes(array.from("SI","SIL","PA","PL","MPL"), _r)
        _v := 1.2
    else if array.includes(array.from("NKD","MNI","FDAX","FDXM"), _r)
        _v := 1.2
    else if array.includes(array.from("GC","MGC","HG","QC","MHG"), _r)
        _v := 0.8
    else if array.includes(array.from("CL","MCL","QM"), _r)
        _v := 0.8
    else if array.includes(array.from("6E","M6E","6A","6C","DX","6B","M6B","6J"), _r)
        _v := 0.8
    _v

f_calc_trail_atr() =>
    float _v = 1.5
    if timeframe.period == "1" or timeframe.period == "3" or timeframe.period == "5"
        _v := 1.0
    else if timeframe.period == "15" or timeframe.period == "30"
        _v := 1.5
    else if timeframe.period == "60"
        _v := 2.0
    else if timeframe.period == "240"
        _v := 2.0
    else if timeframe.period == "D"
        _v := 2.5
    _v

f_calc_tp_tf() =>
    string _v = "1"
    if timeframe.period == "1" or timeframe.period == "2" or timeframe.period == "3" or timeframe.period == "5"
        _v := "1"
    else if timeframe.period == "10" or timeframe.period == "15"
        _v := "3"
    else if timeframe.period == "30"
        _v := "5"
    else if timeframe.period == "60"
        _v := "15"
    else if timeframe.period == "120"
        _v := "30"
    else if timeframe.period == "240"
        _v := "60"
    else if timeframe.period == "D"
        _v := "240"
    else if timeframe.period == "W"
        _v := "D"
    _v

// [V5] 保本停損門檻智能預設
float auto_be_trigger      = f_calc_be_trigger()
float final_be_trigger     = is_auto_active ? auto_be_trigger : manual_be_trigger

// [V5] 追蹤停損 ATR 倍數智能預設
float auto_trail_atr       = f_calc_trail_atr()
float final_trail_atr_mult = is_auto_active ? auto_trail_atr : manual_trail_atr_mult

// [V5] 5分K以下自動停用追蹤停損
bool is_small_tf      = timeframe.period == "1" or timeframe.period == "3" or timeframe.period == "5"
bool effective_trailing = use_trailing_stop and not is_small_tf

// ==============================================================================
// 2. 基礎計算 (Base Calculations)
// ==============================================================================
atr_val    = ta.atr(atr_len)
tick_size  = syminfo.mintick
buffer_val = buffer_ticks * tick_size

// [V5] 停利 MACD 時框自動縮放
string auto_tp_tf_val = f_calc_tp_tf()
string final_tp_tf    = use_auto_tp_tf ? auto_tp_tf_val : manual_tp_tf

[macdLine_tp, signalLine_tp, histLine_tp] = request.security(syminfo.tickerid, final_tp_tf, ta.macd(close, macd_fast, macd_slow, macd_signal))
is_macd_dead_cross_tp   = ta.crossunder(macdLine_tp, signalLine_tp)
is_macd_golden_cross_tp = ta.crossover(macdLine_tp, signalLine_tp)

ma_fast = ta.sma(close, ma_fast_len)
ma_slow = ta.sma(close, ma_slow_len)
is_bull_trend = ma_fast > ma_slow
is_bear_trend = ma_fast < ma_slow

ma_diff = math.abs(ma_fast - ma_slow)
bool is_consolidation = ma_diff < (atr_val * 0.2)
string market_state_str = is_consolidation ? "盤整/糾結 ⚠️" : (is_bull_trend ? "多頭趨勢 🚀" : "空頭趨勢 📉")

// ==============================================================================
// 2.5 多時框均線分析 (MTF Trend Analysis)
// ==============================================================================
get_mtf_trend(res) =>
    f = request.security(syminfo.tickerid, res, ta.sma(close, ma_fast_len))
    s = request.security(syminfo.tickerid, res, ta.sma(close, ma_slow_len))
    a = request.security(syminfo.tickerid, res, ta.atr(atr_len))
    diff = math.abs(f - s)
    is_bull = f > s and diff > (a * 0.2)
    is_bear = f < s and diff > (a * 0.2)
    is_consol = diff <= (a * 0.2)
    [is_bull, is_bear, is_consol]

[bull_w, bear_w, consol_w] = get_mtf_trend("W")
[bull_d, bear_d, consol_d] = get_mtf_trend("D")
[bull_4h, bear_4h, consol_4h] = get_mtf_trend("240")
[bull_1h, bear_1h, consol_1h] = get_mtf_trend("60")
[bull_30m, bear_30m, consol_30m] = get_mtf_trend("30")

// [V4.1 優化] 倉位建議改為 4H + 日線雙重共識
bool is_strong_bull = bull_4h and bull_d
bool is_strong_bear = bear_4h and bear_d

// ==============================================================================
// 3. 狀態變數管理 (State Variables - V4 獨立狀態機)
// ==============================================================================
var int pos_long = 0
var int pos_short = 0

var float long_entry_price = na
var float long_sl_price = na
var float long_tp_price = na
var int long_entry_bar = na

var float short_entry_price = na
var float short_sl_price = na
var float short_tp_price = na
var int short_entry_bar = na

var float target_low_val = na
var float target_low_bar_high = na 
var int target_low_bar_index = na
var bool is_valid_low_setup = false

var float target_high_val = na
var float target_high_bar_low = na 
var int target_high_bar_index = na
var bool is_valid_high_setup = false

var bool long_be_triggered  = false  // 記錄多單是否已觸發保本
var bool short_be_triggered = false  // 記錄空單是否已觸發保本
var float long_sl_prev  = na        // 追蹤停損通知節流用
var float short_sl_prev = na

// ==============================================================================
// 4. 尋找局部極值與急殺急拉 (Extremum & Momentum Logic)
// ==============================================================================
is_pivot_low = low[1] < low[0] and low[1] < low[2]
is_pivot_high = high[1] > high[0] and high[1] > high[2]

float price_drop = na
float price_surge = na

highest_recent = ta.highest(high[1], final_lookback) 
lowest_recent = ta.lowest(low[1], final_lookback) 

if is_pivot_low
    price_drop := highest_recent - low[1]
if is_pivot_high
    price_surge := high[1] - lowest_recent

if is_pivot_low and price_drop > (atr_val[1] * final_atr_mult)
    target_low_val := low[1]
    target_low_bar_high := high[1]
    target_low_bar_index := bar_index[1]
    is_valid_low_setup := true
    if is_valid_high_setup and (bar_index - target_high_bar_index <= final_setup_age_limit)
        is_valid_high_setup := false

if is_pivot_high and price_surge > (atr_val[1] * final_atr_mult)
    target_high_val := high[1]
    target_high_bar_low := low[1]
    target_high_bar_index := bar_index[1]
    is_valid_high_setup := true
    if is_valid_low_setup and (bar_index - target_low_bar_index <= final_setup_age_limit)
        is_valid_low_setup := false

// ==============================================================================
// 5. 進場邏輯 (Entry Logic - V4 獨立進場)
// ==============================================================================
bool long_entry_cond = false
bool trend_allow_long = not use_trend_filter or is_bull_trend
bool allow_long = (trade_dir == "Both" or trade_dir == "Long Only") and trend_allow_long

bool is_breakout = is_valid_low_setup and close > (target_low_bar_high + buffer_val)
bool is_bullish_candle = close > open
bool is_upper_half = close > (high + low) / 2

if pos_long == 0 and allow_long and is_breakout and is_bullish_candle and is_upper_half
    long_entry_cond := true

bool short_entry_cond = false
bool trend_allow_short = not use_trend_filter or is_bear_trend
bool allow_short = (trade_dir == "Both" or trade_dir == "Short Only") and trend_allow_short

bool is_breakdown = is_valid_high_setup and close < (target_high_bar_low - buffer_val)
bool is_bearish_candle = close < open
bool is_lower_half = close < (high + low) / 2

if pos_short == 0 and allow_short and is_breakdown and is_bearish_candle and is_lower_half
    short_entry_cond := true

if long_entry_cond
    pos_long := 1
    long_entry_price := close
    long_entry_bar := bar_index 
    long_sl_price := target_low_val
    long_tp_price := long_entry_price + ((long_entry_price - long_sl_price) * final_rr_ratio)
    is_valid_low_setup := false
    long_be_triggered := false
    long_sl_prev      := na

if short_entry_cond
    pos_short := 1
    short_entry_price := close
    short_entry_bar := bar_index 
    short_sl_price := target_high_val
    short_tp_price := short_entry_price - ((short_sl_price - short_entry_price) * final_rr_ratio)
    is_valid_high_setup := false
    short_be_triggered := false
    short_sl_prev      := na

// ==============================================================================
// 6. 出場邏輯 (Exit Logic - V4 獨立出場)
// ==============================================================================
bool long_sl_cond = false
bool long_tp_cond = false
bool short_sl_cond = false
bool short_tp_cond = false

// [V5] 停利最低獲利門檻依時框自動調整
float auto_min_profit_ratio = 0.5
if timeframe.period == "1" or timeframe.period == "3" or timeframe.period == "5"
    auto_min_profit_ratio := 0.3
else if timeframe.period == "240" or timeframe.period == "D"
    auto_min_profit_ratio := 0.8
else if timeframe.period == "W"
    auto_min_profit_ratio := 1.0

// [V5] 保本停損
if pos_long == 1 and use_be_stop and not long_be_triggered
    float sl_dist = math.abs(long_entry_price - long_sl_price)
    if close > (long_entry_price + sl_dist * final_be_trigger) and long_sl_price < long_entry_price
        long_sl_price     := long_entry_price
        long_be_triggered := true

// [V5] 追蹤停損（保本後才啟動）
// 使用 high[1]/low[1]，避免未收盤 K 棒內追蹤价不斷跟蹤修正
if pos_long == 1 and effective_trailing and long_be_triggered
    float trail_price = high[1] - (atr_val * final_trail_atr_mult)
    if trail_price > long_sl_price
        long_sl_prev  := long_sl_price
        long_sl_price := trail_price

// 空單對稱邏輯
if pos_short == 1 and use_be_stop and not short_be_triggered
    float sl_dist = math.abs(short_entry_price - short_sl_price)
    if close < (short_entry_price - sl_dist * final_be_trigger) and short_sl_price > short_entry_price
        short_sl_price     := short_entry_price
        short_be_triggered := true

if pos_short == 1 and effective_trailing and short_be_triggered
    float trail_price = low[1] + (atr_val * final_trail_atr_mult)
    if trail_price < short_sl_price
        short_sl_prev  := short_sl_price
        short_sl_price := trail_price

if pos_long == 1
    bool can_tp_long = bar_index > long_entry_bar
    if low <= long_sl_price
        long_sl_cond := true
    else
        float sl_distance = math.abs(long_entry_price - long_sl_price)
        bool has_min_profit = close > (long_entry_price + sl_distance * auto_min_profit_ratio)
        if can_tp_long and has_min_profit and is_macd_dead_cross_tp
            long_tp_cond := true
    if long_sl_cond or long_tp_cond
        pos_long := 0
        long_be_triggered := false
        long_sl_prev      := na

if pos_short == 1
    bool can_tp_short = bar_index > short_entry_bar
    if high >= short_sl_price
        short_sl_cond := true
    else
        float sl_distance = math.abs(short_entry_price - short_sl_price)
        bool has_min_profit = close < (short_entry_price - sl_distance * auto_min_profit_ratio)
        if can_tp_short and has_min_profit and is_macd_golden_cross_tp
            short_tp_cond := true
    if short_sl_cond or short_tp_cond
        pos_short := 0
        short_be_triggered := false
        short_sl_prev      := na

// ==============================================================================
// 7. 警報與通知邏輯 (Alerts & Telegram Logic - V4.1)
// ==============================================================================
// --- V4.1 商品名稱翻譯對照表 ---
f_get_chinese_name(ticker) =>
    switch ticker
        "TXF1!"  => "台指期"
        "MXF1!"  => "小型台指期"
        "TMF1!"  => "微型台指期"
        "TWN1!"  => "富時台指"
        "MTWN1!" => "微型富時台指"
        "DX1!"   => "美元指數"
        "US02Y"  => "美2年債"
        "US10Y"  => "美10年債"
        "MNQ1!"  => "微型那指"
        "MES1!"  => "微型標普"
        "MYM1!"  => "微型道瓊"
        "M2K1!"  => "微型羅素"
        "NK2251!"=> "日經225"
        "CL1!"   => "原油"
        "MCL1!"  => "微型原油"
        "MNG1!"  => "微型天然氣"
        "GC1!"   => "黃金"
        "MGC1!"  => "微型黃金"
        "SI1!"   => "白銀"
        "HG1!"   => "銅"
        "MHG1!"  => "微型銅"
        "ZS1!"   => "黃豆"
        "ZC1!"   => "玉米"
        "ZW1!"   => "小麥"
        "CT1!"   => "棉花"
        "SB1!"   => "11號糖"
        "M6E1!"  => "微型歐元"
        "M6A1!"  => "微型澳幣"
        "M6B1!"  => "微型英鎊"
        "MCD1!"  => "微型加幣"
        "6J1!"   => "日幣"
        "CDF1!"  => "台積電期貨"
        "RVF1!"  => "台達電期貨"
        "CCF1!"  => "聯電期貨"
        "2330"   => "台積電"
        => ticker

// --- V4.1 時區翻譯對照表 ---
f_get_tf_name(period) =>
    switch period
        "1" => "1分"
        "3" => "3分"
        "5" => "5分"
        "15" => "15分"
        "30" => "30分"
        "60" => "1H"
        "120" => "2H"
        "240" => "4H"
        "D" => "日K"
        "W" => "週K"
        "M" => "月K"
        => period + "分"

// --- V4.1 台灣習慣色系判斷 (紅=多, 綠=空) ---
f_trend_dot(is_bull, is_bear) =>
    is_bull ? "🔴" : (is_bear ? "🟢" : "🟡")

// [V5] 跨時框進場建議
f_get_entry_guidance() =>
    string _v = "\n💡 建議：明日降至 4H/1H 尋找精確進場點，直接進場成本可能偏差大"
    if timeframe.period == "1" or timeframe.period == "3" or timeframe.period == "5"
        _v := ""
    else if timeframe.period == "15" or timeframe.period == "30"
        _v := "\n💡 建議：可等下根開盤進場，避免追高"
    else if timeframe.period == "60"
        _v := "\n💡 建議：降至 15 分 K 確認精確進場點"
    else if timeframe.period == "240"
        _v := "\n💡 建議：降至 1H 確認進場點，注意成本差異"
    _v

time_str = str.format_time(timenow, "yyyy-MM-dd HH:mm", "UTC+8")
tf_name = f_get_tf_name(timeframe.period)
c_name = f_get_chinese_name(syminfo.ticker)
disp_name = c_name == syminfo.ticker ? syminfo.ticker : c_name + " (" + syminfo.ticker + ")"

mtf_w_str  = f_trend_dot(bull_w, bear_w)
mtf_d_str  = f_trend_dot(bull_d, bear_d)
mtf_4h_str = f_trend_dot(bull_4h, bear_4h)
mtf_1h_str = f_trend_dot(bull_1h, bear_1h)

int long_stars = 1
if bull_1h
    long_stars += 1
if bull_4h
    long_stars += 1
if bull_d
    long_stars += 2
if long_stars > 5
    long_stars := 5

int short_stars = 1
if bear_1h
    short_stars += 1
if bear_4h
    short_stars += 1
if bear_d
    short_stars += 2
if short_stars > 5
    short_stars := 5

get_stars(stars) =>
    str.repeat("⭐", stars)

get_trend_desc(is_long) =>
    if is_long
        if bull_d and bull_4h and bull_1h
            "週/日/4H全順勢"
        else if bull_4h and bull_1h
            "1H/4H順勢，日線逆勢"
        else if bull_d and bull_4h
            "日/4H順勢，1H震盪"
        else
            "短線逆勢進場"
    else
        if bear_d and bear_4h and bear_1h
            "週/日/4H全順勢"
        else if bear_4h and bear_1h
            "1H/4H順勢，日線逆勢"
        else if bear_d and bear_4h
            "日/4H順勢，1H震盪"
        else
            "短線逆勢進場"

string mtf_dashboard_str = "週" + mtf_w_str + "｜日" + mtf_d_str + "｜4H" + mtf_4h_str + "｜1H" + mtf_1h_str

// V5 訊息字串組合 (優化版 2行顯示 + 跨時框引導)
string long_msg = "📈 【做多進場】" + disp_name + " " + tf_name + "\n" +
                  "進場：" + str.tostring(close) + "｜停損：" + str.tostring(target_low_val) + "（-" + str.tostring(close - target_low_val, "#.##") + "點）｜目標：" + str.tostring(long_tp_price, "#.##") + "\n" +
                  get_stars(long_stars) + " " + get_trend_desc(true) + "｜" + (is_strong_bull ? "標準倉位" : "縮半倉⚠️") + "\n" +
                  "📊 " + mtf_dashboard_str + "\n" +
                  "🎯 停利參考：" + f_get_tf_name(final_tp_tf) + " MACD 死叉時出場" + f_get_entry_guidance() + "\n" +
                  "⏰ " + time_str + "（台灣）"

string short_msg = "📉 【做空進場】" + disp_name + " " + tf_name + "\n" +
                   "進場：" + str.tostring(close) + "｜停損：" + str.tostring(target_high_val) + "（-" + str.tostring(target_high_val - close, "#.##") + "點）｜目標：" + str.tostring(short_tp_price, "#.##") + "\n" +
                   get_stars(short_stars) + " " + get_trend_desc(false) + "｜" + (is_strong_bear ? "標準倉位" : "縮半倉⚠️") + "\n" +
                   "📊 " + mtf_dashboard_str + "\n" +
                   "🎯 停利參考：" + f_get_tf_name(final_tp_tf) + " MACD 金叉時出場" + f_get_entry_guidance() + "\n" +
                   "⏰ " + time_str + "（台灣）"

string long_tp_msg = "💰 【停利出場】" + disp_name + " " + tf_name + "\n" +
                     str.tostring(long_entry_price) + " ➔ " + str.tostring(close) + "｜獲利 +" + str.tostring(close - long_entry_price, "#.##") + "點 🚀\n" +
                     "⏰ " + time_str + "（台灣）"

string short_tp_msg = "💰 【停利出場】" + disp_name + " " + tf_name + "\n" +
                      str.tostring(short_entry_price) + " ➔ " + str.tostring(close) + "｜獲利 +" + str.tostring(short_entry_price - close, "#.##") + "點 🚀\n" +
                      "⏰ " + time_str + "（台灣）"

// 停損反手提醒
string rev_long_sl = short_stars >= 3 ? "\n⚠️ 多方轉空方，建議反手做空\n📊 " + mtf_dashboard_str + "（趨勢轉弱）\n" : "\n"
string long_sl_msg = "🛑 【停損出場】" + disp_name + " " + tf_name + "\n" +
                     str.tostring(long_entry_price) + " ➔ " + str.tostring(close) + "｜損失 -" + str.tostring(long_entry_price - close, "#.##") + "點\n" +
                     rev_long_sl + 
                     "⏰ " + time_str + "（台灣）"

string rev_short_sl = long_stars >= 3 ? "\n⚠️ 空方轉多方，建議反手做多\n📊 " + mtf_dashboard_str + "（趨勢轉強）\n" : "\n"
string short_sl_msg = "🛑 【停損出場】" + disp_name + " " + tf_name + "\n" +
                      str.tostring(short_entry_price) + " ➔ " + str.tostring(close) + "｜損失 -" + str.tostring(close - short_entry_price, "#.##") + "點\n" +
                      rev_short_sl + 
                      "⏰ " + time_str + "（台灣）"

string long_be_msg = "🔐 【停損移至保本】" + disp_name + " " + tf_name + "\n" +
                     "停損更新至進場價 " + str.tostring(long_entry_price) + "\n" +
                     "已確保此單不虧損！請手動更新交易所停損掛單。\n" +
                     "⏰ " + time_str + "（台灣）"

string short_be_msg = "🔐 【停損移至保本】" + disp_name + " " + tf_name + "\n" +
                      "停損更新至進場價 " + str.tostring(short_entry_price) + "\n" +
                      "已確保此單不虧損！請手動更新交易所停損掛單。\n" +
                      "⏰ " + time_str + "（台灣）"

string long_trail_msg = "🔒 【追蹤停損更新】" + disp_name + " " + tf_name + "\n" + "停損上移至 " + str.tostring(long_sl_price, "#.##") + "（前值 " + str.tostring(long_sl_prev, "#.##") + "）\n" + "浮盈已鎖住 " + str.tostring(long_sl_price - long_entry_price, "#.##") + " 點，請手動更新交易所停損掛單。\n" + "⏰ " + time_str + "（台灣）"

string short_trail_msg = "🔒 【追蹤停損更新】" + disp_name + " " + tf_name + "\n" + "停損下移至 " + str.tostring(short_sl_price, "#.##") + "（前值 " + str.tostring(short_sl_prev, "#.##") + "）\n" + "浮盈已鎖住 " + str.tostring(short_entry_price - short_sl_price, "#.##") + " 點，請手動更新交易所停損掛單。\n" + "⏰ " + time_str + "（台灣）"

if long_entry_cond
    alert(long_msg, alert.freq_once_per_bar_close)
if short_entry_cond
    alert(short_msg, alert.freq_once_per_bar_close)

if long_sl_cond
    alert(long_sl_msg, alert.freq_once_per_bar)
if long_tp_cond
    alert(long_tp_msg, alert.freq_once_per_bar)
if short_sl_cond
    alert(short_sl_msg, alert.freq_once_per_bar)
if short_tp_cond
    alert(short_tp_msg, alert.freq_once_per_bar)

// [V5] 保本觸發標籤判斷 (用於 UI 標籤與警報)
bool be_just_triggered_long  = long_be_triggered  and not long_be_triggered[1]  and pos_long == 1
bool be_just_triggered_short = short_be_triggered and not short_be_triggered[1] and pos_short == 1

if be_just_triggered_long
    alert(long_be_msg, alert.freq_once_per_bar)
if be_just_triggered_short
    alert(short_be_msg, alert.freq_once_per_bar)

// [V5] 追蹤停損通知（節流：移動 >= 0.5 ATR 才發）
bool long_trail_notify  = pos_long == 1  and effective_trailing and long_be_triggered  and
                          not na(long_sl_prev)  and math.abs(long_sl_price - long_sl_prev)  >= (atr_val * 0.5)
bool short_trail_notify = pos_short == 1 and effective_trailing and short_be_triggered and
                          not na(short_sl_prev) and math.abs(short_sl_price - short_sl_prev) >= (atr_val * 0.5)

if long_trail_notify
    alert(long_trail_msg, alert.freq_once_per_bar)
    long_sl_prev := long_sl_price   // 重置節流基準

if short_trail_notify
    alert(short_trail_msg, alert.freq_once_per_bar)
    short_sl_prev := short_sl_price

alertcondition(long_entry_cond,              title="做多進場",  message="5K V5：做多進場訊號")
alertcondition(short_entry_cond,             title="做空進場",  message="5K V5：做空進場訊號")
alertcondition(long_sl_cond,                 title="多單停損",  message="5K V5：多單停損出場")
alertcondition(long_tp_cond,                 title="多單停利",  message="5K V5：多單停利出場")
alertcondition(short_sl_cond,                title="空單停損",  message="5K V5：空單停損出場")
alertcondition(short_tp_cond,                title="空單停利",  message="5K V5：空單停利出場")

// ==============================================================================
// 8. 視覺化呈現 (Visuals)
// ==============================================================================
plotshape(long_entry_cond, title="Long Entry", style=shape.triangleup, location=location.belowbar, color=col_long_entry, size=size.auto)
plotshape(short_entry_cond, title="Short Entry", style=shape.triangledown, location=location.abovebar, color=col_short_entry, size=size.auto)

plotshape(long_sl_cond, title="Long Stop Loss", style=shape.triangledown, location=location.abovebar, color=col_long_exit, size=size.auto, text="SL", textcolor=col_long_exit)
plotchar(long_tp_cond, title="Long Take Profit", char="＄", location=location.abovebar, color=col_long_exit, size=size.auto, text="TP", textcolor=col_long_exit)

plotshape(short_sl_cond, title="Short Stop Loss", style=shape.triangleup, location=location.belowbar, color=col_short_exit, size=size.auto, text="SL", textcolor=col_short_exit)
plotchar(short_tp_cond, title="Short Take Profit", char="＄", location=location.belowbar, color=col_short_exit, size=size.auto, text="TP", textcolor=col_short_exit)

plot(show_base and is_valid_low_setup and pos_long == 0 ? target_low_val : na, title="Target Low", color=col_base_line, style=plot.style_linebr, linewidth=2)
plot(show_base and is_valid_high_setup and pos_short == 0 ? target_high_val : na, title="Target High", color=col_base_line, style=plot.style_linebr, linewidth=2)

plot(show_sl and pos_long == 1 ? long_sl_price : na, title="Long Stop Loss Line", color=col_sl_line, style=plot.style_linebr, linewidth=1)
plot(show_tp and pos_long == 1 ? long_tp_price : na, title="Long Target Line", color=col_tp_line, style=plot.style_linebr, linewidth=1)
plot(show_sl and pos_short == 1 ? short_sl_price : na, title="Short Stop Loss Line", color=col_sl_line, style=plot.style_linebr, linewidth=1)
plot(show_tp and pos_short == 1 ? short_tp_price : na, title="Short Target Line", color=col_tp_line, style=plot.style_linebr, linewidth=1)

plot(show_ma ? ma_fast : na, title="Fast MA", color=col_ma_fast, linewidth=2)
plot(show_ma ? ma_slow : na, title="Slow MA", color=col_ma_slow, linewidth=2)

// [V5] 保本觸發標籤
if be_just_triggered_long
    label.new(bar_index, long_entry_price, "BE",
        color=color.aqua, textcolor=color.black,
        style=label.style_label_left, size=size.small,
        tooltip="停損已移至保本（進場成本）")

if be_just_triggered_short
    label.new(bar_index, short_entry_price, "BE",
        color=color.aqua, textcolor=color.black,
        style=label.style_label_right, size=size.small,
        tooltip="停損已移至保本（進場成本）")

// ==============================================================================
// 9. 資訊面板 (Dashboard)
// ==============================================================================
var string p_pos = panel_pos_str == "Top Right" ? position.top_right : panel_pos_str == "Middle Right" ? position.middle_right : panel_pos_str == "Bottom Left" ? position.bottom_left : panel_pos_str == "Top Left" ? position.top_left : position.bottom_right
var string p_size = panel_size_str == "Tiny" ? size.tiny : panel_size_str == "Small" ? size.small : size.normal

var table panel = table.new(p_pos, 2, 12, bgcolor=color.new(color.black, 80), border_width=1, border_color=color.gray)

if show_table and barstate.islast
    table.cell(panel, 0, 0, "5K Strategy Master", text_color=color.white, text_halign=text.align_left, text_size=p_size)
    table.cell(panel, 1, 0, "v5.0", text_color=color.lime, text_halign=text.align_right, text_size=p_size)
    
    string mode_txt = is_auto_active ? "Auto (智能)" : "Manual (手動)"
    color mode_col = is_auto_active ? color.orange : color.gray
    table.cell(panel, 0, 1, "Mode:", text_color=color.white, text_halign=text.align_left, text_size=p_size)
    table.cell(panel, 1, 1, mode_txt, text_color=mode_col, text_halign=text.align_right, text_size=p_size)
    
    table.cell(panel, 0, 2, "Asset:", text_color=color.white, text_halign=text.align_left, text_size=p_size)
    table.cell(panel, 1, 2, asset_class, text_color=color.yellow, text_halign=text.align_right, text_size=p_size)
    
    string status_txt = (pos_long == 1 and pos_short == 1) ? "Hedged (雙向)" : (pos_long == 1 ? "Long (多單)" : (pos_short == 1 ? "Short (空單)" : "Waiting (等待)"))
    color status_col = (pos_long == 1 and pos_short == 1) ? color.yellow : (pos_long == 1 ? color.red : (pos_short == 1 ? color.green : color.gray))
    table.cell(panel, 0, 3, "Status:", text_color=color.white, text_halign=text.align_left, text_size=p_size)
    table.cell(panel, 1, 3, status_txt, text_color=status_col, text_halign=text.align_right, text_size=p_size)
    
    table.cell(panel, 0, 4, "Current ATR:", text_color=color.white, text_halign=text.align_left, text_size=p_size)
    table.cell(panel, 1, 4, str.tostring(atr_val, "#.##"), text_color=color.yellow, text_halign=text.align_right, text_size=p_size)
    
    string macd_txt = macdLine_tp > signalLine_tp ? "Bullish (多)" : "Bearish (空)"
    color macd_col = macdLine_tp > signalLine_tp ? color.red : color.green
    table.cell(panel, 0, 5, f_get_tf_name(final_tp_tf) + " MACD:", text_color=color.white, text_halign=text.align_left, text_size=p_size)
    table.cell(panel, 1, 5, macd_txt, text_color=macd_col, text_halign=text.align_right, text_size=p_size)
    
    string trend_txt = is_bull_trend ? "Bullish (多頭)" : "Bearish (空頭)"
    color trend_col = is_bull_trend ? color.red : color.green
    table.cell(panel, 0, 6, "MA Trend:", text_color=color.white, text_halign=text.align_left, text_size=p_size)
    table.cell(panel, 1, 6, trend_txt, text_color=trend_col, text_halign=text.align_right, text_size=p_size)
    
    table.cell(panel, 0, 7, "Market State:", text_color=color.white, text_halign=text.align_left, text_size=p_size)
    table.cell(panel, 1, 7, market_state_str, text_color=is_consolidation ? color.yellow : (is_bull_trend ? color.red : color.green), text_halign=text.align_right, text_size=p_size)

    string display_sug = pos_long == 1 ? (is_strong_bull ? "標準倉位 (4H+日線順勢)" : "縮半倉⚠️ (大週期逆勢)") : (pos_short == 1 ? (is_strong_bear ? "標準倉位 (4H+日線順勢)" : "縮半倉⚠️ (大週期逆勢)") : (is_strong_bull ? "偏多 (4H+日線順勢)" : (is_strong_bear ? "偏空 (4H+日線順勢)" : "盤整觀望")))
    table.cell(panel, 0, 8, "Sizing Sug.:", text_color=color.white, text_halign=text.align_left, text_size=p_size)
    table.cell(panel, 1, 8, display_sug, text_color=color.yellow, text_halign=text.align_right, text_size=p_size)

    table.cell(panel, 0, 9, is_auto_active ? "Setup Age (Auto):" : "Setup Age (Man.):", text_color=color.white, text_halign=text.align_left, text_size=p_size)
    table.cell(panel, 1, 9, str.tostring(final_setup_age_limit) + " bars", text_color=color.aqua, text_halign=text.align_right, text_size=p_size)

    // TP MACD TF（第 10 列）
    table.cell(panel, 0, 10, "TP MACD TF:", text_color=color.white, text_halign=text.align_left, text_size=p_size)
    table.cell(panel, 1, 10, f_get_tf_name(final_tp_tf), text_color=color.aqua, text_halign=text.align_right, text_size=p_size)

    // SL Mode（第 11 列）
    // has_trailed = 保本後停損有實際移動過，才算啟動 Trailing
    bool has_trailed_long  = long_be_triggered  and not na(long_sl_prev)  and long_sl_price  > long_entry_price
    bool has_trailed_short = short_be_triggered and not na(short_sl_prev) and short_sl_price < short_entry_price
    string sl_mode_long  = not use_be_stop ? "Fixed" : (not long_be_triggered  ? "Fixed" : (has_trailed_long  ? "Trailing" : "Breakeven"))
    string sl_mode_short = not use_be_stop ? "Fixed" : (not short_be_triggered ? "Fixed" : (has_trailed_short ? "Trailing" : "Breakeven"))
    string sl_mode_txt   = pos_long == 1 ? sl_mode_long : (pos_short == 1 ? sl_mode_short : "—")
    color sl_mode_col    = sl_mode_txt == "Trailing" ? color.lime : (sl_mode_txt == "Breakeven" ? color.aqua : color.gray)
    table.cell(panel, 0, 11, "SL Mode:", text_color=color.white, text_halign=text.align_left, text_size=p_size)
    table.cell(panel, 1, 11, sl_mode_txt, text_color=sl_mode_col, text_halign=text.align_right, text_size=p_size)
