//@version=6
indicator("5K Strategy Master V2", shorttitle="5K戰法 V2", overlay=true, max_labels_count=500)

// ==============================================================================
// 1. 參數設定 (Inputs)
// ==============================================================================
grp_auto = "智能模式 (Smart Mode)"
use_auto_params = input.bool(true, title="啟用智能商品辨識 (Auto-Detect Parameters)", group=grp_auto, tooltip="開啟時，自動辨識圖表商品並覆寫最佳化的回溯區間、ATR乘數與風報比。")

grp_momentum = "動能過濾與極值 (手動設定 Manual)"
lookback_bars = input.int(48, title="回溯區間 (Lookback Bars, 48=4H)", group=grp_momentum, tooltip="手動模式下尋找局部最高/最低點的範圍\n✅ 股指期貨（台指/那指/標普/道瓊）：48~60根\n✅ 全天交易商品（黃金/原油/外匯）：72~96根")
atr_len = input.int(5, title="ATR 週期 (ATR Length)", group=grp_momentum, tooltip="計算波動幅度的週期\n✅ 平衡市場：5根（預設）\n⚠️ 趨勢市：可調至 8~10 根更穩定")
atr_mult = input.float(1.5, title="急殺/急拉 ATR 乘數", group=grp_momentum, step=0.1, tooltip="手動模式下：波動需多大才算急殺/急拉，越大訊號越少但越精\n\n指數期貨\n✅ 台指/富台/標普/道瓊：1.5~2.0\n✅ 那指/羅素：1.5~2.0\n⚠️ 日經/德指：2.0~2.5\n❌ 恆生：謹慎，政策風險大\n\n原物料\n✅ 黃金/銅：1.5~2.0（趨勢佳）\n✅ 原油：1.5~2.0\n⚠️ 白銀：2.0~2.5（每跳$5，風險大）\n⚠️ 農產品（黃豆/玉米/小麥）：1.5~2.0\n❌ 天然氣：2.5~3.0，謹慎\n\n外匯期貨\n⚠️ 歐元/英鎊/日幣：1.0~1.5\n❌ 澳幣/加幣：波動太小，訊號難觸發")

grp_entry = "進場微調 (Entry Settings)"
trade_dir = input.string("Both", title="交易方向 (Trade Direction)", options=["Both", "Long Only", "Short Only"], group=grp_entry, tooltip="過濾不想要的方向\n✅ 大漲中後期：選 Long Only\n✅ 高空後期：選 Short Only\n✅ 平衡市場：選 Both\nℹ️ 啟用 17/88MA 過濾器時，此選項與MA方向雙重篩選")
buffer_ticks = input.int(1, title="突破緩衝 (Buffer Ticks)", group=grp_entry, tooltip="突破極值時的額外確認空間\n✅ 股指/多數商品：1 tick（預設）\n⚠️ 外匯期貨：可調至 2 tick\nℹ️ 數字越大越不易被假突破，但進場會稍慢")

grp_exit = "停利設定 (手動設定 Manual)"
rr_ratio = input.float(1.5, title="快速停利風報比", group=grp_exit, step=0.1, tooltip="手動模式下：目標價距進場價的倍數，1.5 = 獲利是停損的 1.5 倍\n\n建議\n✅ 趨勢性強商品（黃金/銅/那指）：2.0，讓獲利空間更大\n✅ 原油：1.5~2.0 交替使用\n⚠️ 盤整商品（外匯/農產品）：維持 1.5，快進快出\n❌ 天然氣/恆生：不建議使用此指標")

grp_trend = "均線趨勢過濾 (Trend Filter)"
use_trend_filter = input.bool(true, title="啟用均線趨勢過濾", group=grp_trend, tooltip="啟用後，17MA > 88MA 時僅允許做多，反之僅允許做空")
ma_fast_len = input.int(17, title="快速均線長度 (Fast MA)", group=grp_trend)
ma_slow_len = input.int(88, title="慢速均線長度 (Slow MA)", group=grp_trend)
col_ma_fast = input.color(color.yellow, title="快速均線顏色", group=grp_trend)
col_ma_slow = input.color(color.fuchsia, title="慢速均線顏色", group=grp_trend)
show_ma = input.bool(true, title="顯示均線於圖表上", group=grp_trend)

grp_visual = "視覺顯示 (Visual Settings)"
show_sl = input.bool(true, title="顯示停損線 (Stop Loss)", group=grp_visual, tooltip="開啟時，會在持倉期間顯示防守停損位置的水平線")
show_tp = input.bool(false, title="顯示目標價線 (First Target)", group=grp_visual, tooltip="開啟時，會在持倉期間顯示預期達標(風報比)的獲利位置")
show_base = input.bool(false, title="顯示極值基準線 (Base Lines)", group=grp_visual, tooltip="開啟時，會在等待進場時顯示目前監控突破的最高/最低點水平線")
show_table = input.bool(true, title="顯示 Dashboard 面板", group=grp_visual, tooltip="顯示目前的狀態與 ATR 等數據面板")
panel_pos_str = input.string("Middle Right", title="面板位置 (Panel Position)", options=["Top Right", "Middle Right", "Bottom Right", "Bottom Left", "Top Left"], group=grp_visual)
panel_size_str = input.string("Small", title="面板文字大小 (Text Size)", options=["Tiny", "Small", "Normal"], group=grp_visual)

grp_colors = "顏色設定 (Color Settings)"
col_long_entry = input.color(color.red, title="做多進場箭頭顏色 (Long Entry)", group=grp_colors, tooltip="設定買入箭頭(▲)的顏色")
col_short_entry = input.color(color.green, title="做空進場箭頭顏色 (Short Entry)", group=grp_colors, tooltip="設定放空箭頭(▼)的顏色")
col_long_exit = input.color(color.yellow, title="做多出場 ＄ 顏色 (Long Exit)", group=grp_colors, tooltip="設定多單獲利出場符號的顏色")
col_short_exit = input.color(color.yellow, title="做空出場 ＄ 顏色 (Short Exit)", group=grp_colors, tooltip="設定空單獲利出場符號的顏色")
col_sl_line = input.color(color.new(#ff82b2, 0), title="停損線顏色 (Stop Loss Line)", group=grp_colors, tooltip="設定停損水平線的顏色與透明度")
col_tp_line = input.color(color.new(#4dd0e1, 0), title="目標價線顏色 (Target Line)", group=grp_colors, tooltip="設定目標價水平線的顏色與透明度")
col_base_line = input.color(color.new(color.gray, 70), title="極值基準線顏色 (Base Line)", group=grp_colors, tooltip="設定等待突破的基準線顏色與透明度")

grp_macd = "1分K MACD 停利參數 (MTF MACD)"
macd_fast = input.int(12, title="MACD 快線", group=grp_macd)
macd_slow = input.int(26, title="MACD 慢線", group=grp_macd)
macd_signal = input.int(9, title="MACD 訊號線", group=grp_macd)

// ==============================================================================
// 1.5 智能商品辨識邏輯 (Auto-Detect Logic)
// ==============================================================================
string r = syminfo.root
string asset_class = "Unknown"
float auto_atr_mult = 1.5
float auto_rr_ratio = 1.5
int auto_lookback = 48

// Indices
if array.includes(array.from("TX", "MTX", "TWN"), r)
    asset_class := "Taiwan Index (TX/TWN)"
    auto_atr_mult := 1.5, auto_rr_ratio := 1.5, auto_lookback := 48
else if array.includes(array.from("ES", "MES", "YM", "MYM"), r)
    asset_class := "US Index (Stable)"
    auto_atr_mult := 1.5, auto_rr_ratio := 1.5, auto_lookback := 48
else if array.includes(array.from("NQ", "MNQ", "RTY", "M2K"), r)
    asset_class := "US Index (Volatile)"
    auto_atr_mult := 2.0, auto_rr_ratio := 2.0, auto_lookback := 48
else if array.includes(array.from("NKD", "MNI", "NK225", "NK225M", "NK225MC", "FDAX", "FDXM"), r)
    asset_class := "Intl Index (High Vol)"
    auto_atr_mult := 2.2, auto_rr_ratio := 2.0, auto_lookback := 48
else if array.includes(array.from("HSI", "HHI", "MHI", "MCH"), r)
    asset_class := "Hang Seng"
    auto_atr_mult := 2.5, auto_rr_ratio := 2.0, auto_lookback := 48
    
// Commodities
else if array.includes(array.from("GC", "MGC", "HG", "QC", "MHG"), r)
    asset_class := "Metals (Trend)"
    auto_atr_mult := 1.5, auto_rr_ratio := 2.0, auto_lookback := 72
else if array.includes(array.from("SI", "SIL"), r)
    asset_class := "Silver (High Vol)"
    auto_atr_mult := 2.5, auto_rr_ratio := 2.0, auto_lookback := 72
else if array.includes(array.from("CL", "MCL", "QM"), r)
    asset_class := "Crude Oil"
    auto_atr_mult := 2.0, auto_rr_ratio := 1.5, auto_lookback := 72
else if array.includes(array.from("NG", "QG", "MNG"), r)
    asset_class := "Natural Gas"
    auto_atr_mult := 3.0, auto_rr_ratio := 2.0, auto_lookback := 72
else if array.includes(array.from("ZS", "ZC", "ZW", "ZL"), r)
    asset_class := "Agriculture"
    auto_atr_mult := 1.5, auto_rr_ratio := 1.5, auto_lookback := 48
else if array.includes(array.from("CT"), r)
    asset_class := "Cotton"
    auto_atr_mult := 2.0, auto_rr_ratio := 2.0, auto_lookback := 48
    
// Forex
else if array.includes(array.from("6E", "M6E", "6A", "6C", "DX"), r)
    asset_class := "Forex (Low Vol)"
    auto_atr_mult := 1.2, auto_rr_ratio := 1.5, auto_lookback := 72
else if array.includes(array.from("6B", "M6B", "6J", "XJK", "JPYUSD", "USDJPY"), r)
    asset_class := "Forex (Mid Vol)"
    auto_atr_mult := 1.5, auto_rr_ratio := 1.5, auto_lookback := 72

// 決定最終參數 (如果開啟自動辨識且成功辨識商品，則覆寫手動設定)
bool is_auto_active = use_auto_params and asset_class != "Unknown"
final_atr_mult = is_auto_active ? auto_atr_mult : atr_mult
final_rr_ratio = is_auto_active ? auto_rr_ratio : rr_ratio
final_lookback = is_auto_active ? auto_lookback : lookback_bars

// ==============================================================================
// 2. 基礎計算 (Base Calculations)
// ==============================================================================
atr_val = ta.atr(atr_len)
tick_size = syminfo.mintick
buffer_val = buffer_ticks * tick_size

// 取得 1分K 的 MACD 狀態
[macdLine_1m, signalLine_1m, histLine_1m] = request.security(syminfo.tickerid, "1", ta.macd(close, macd_fast, macd_slow, macd_signal))
is_macd_dead_cross_1m = ta.crossunder(macdLine_1m, signalLine_1m)
is_macd_golden_cross_1m = ta.crossover(macdLine_1m, signalLine_1m)

// 計算趨勢均線
ma_fast = ta.sma(close, ma_fast_len)
ma_slow = ta.sma(close, ma_slow_len)
is_bull_trend = ma_fast > ma_slow
is_bear_trend = ma_fast < ma_slow

// ==============================================================================
// 3. 狀態變數管理 (State Variables)
// ==============================================================================
// 0: 等待進場 (Wait), 1: 持有多單 (Long), -1: 持有空單 (Short)
var int position_state = 0
var float entry_price = na
var float stop_loss_price = na
var float first_target_price = na
var int last_entry_bar = na // 記錄最近一次進場的 K 棒索引，防止同根 K 棒出場

// 記錄當前用來做突破基準的極值 K 棒資訊
var float target_low_val = na
var float target_low_bar_high = na 
var float target_high_val = na
var float target_high_bar_low = na 
var bool is_valid_low_setup = false
var bool is_valid_high_setup = false

// ==============================================================================
// 4. 尋找局部極值與急殺急拉 (Extremum & Momentum Logic)
// ==============================================================================

// 判斷當前是否為局部極值 (Pivot Low/High)
is_pivot_low = low[1] < low[0] and low[1] < low[2]
is_pivot_high = high[1] > high[0] and high[1] > high[2]

// 計算急殺急拉的幅度
float price_drop = na
float price_surge = na

// 歷史函數必須放在全域環境計算。修正舊版 hardcode 10 的 bug，改用 final_lookback
highest_recent = ta.highest(high[1], final_lookback) 
lowest_recent = ta.lowest(low[1], final_lookback) 

if is_pivot_low
    price_drop := highest_recent - low[1]
    
if is_pivot_high
    price_surge := high[1] - lowest_recent

// 更新有效 Setup 狀態
if is_pivot_low and price_drop > (atr_val[1] * final_atr_mult)
    target_low_val := low[1]
    target_low_bar_high := high[1]
    is_valid_low_setup := true
    is_valid_high_setup := false

if is_pivot_high and price_surge > (atr_val[1] * final_atr_mult)
    target_high_val := high[1]
    target_high_bar_low := low[1]
    is_valid_high_setup := true
    is_valid_low_setup := false

// ==============================================================================
// 5. 進場邏輯 (Entry Logic)
// ==============================================================================
// 做多進場條件 (Long Entry)
bool long_entry_cond = false
bool trend_allow_long = not use_trend_filter or is_bull_trend
bool allow_long = (trade_dir == "Both" or trade_dir == "Long Only") and trend_allow_long

// 價格大於基準高點 + 緩衝，且收陽線，且收盤在K棒上半部
bool is_breakout = is_valid_low_setup and close > (target_low_bar_high + buffer_val)
bool is_bullish_candle = close > open
bool is_upper_half = close > (high + low) / 2

if position_state == 0 and allow_long and is_breakout and is_bullish_candle and is_upper_half
    long_entry_cond := true

// 做空進場條件 (Short Entry)
bool short_entry_cond = false
bool trend_allow_short = not use_trend_filter or is_bear_trend
bool allow_short = (trade_dir == "Both" or trade_dir == "Short Only") and trend_allow_short

// 價格小於基準低點 - 緩衝，且收陰線，且收盤在K棒下半部
bool is_breakdown = is_valid_high_setup and close < (target_high_bar_low - buffer_val)
bool is_bearish_candle = close < open
bool is_lower_half = close < (high + low) / 2

if position_state == 0 and allow_short and is_breakdown and is_bearish_candle and is_lower_half
    short_entry_cond := true

// 執行進場狀態更新
if long_entry_cond
    position_state := 1
    entry_price := close
    last_entry_bar := bar_index 
    stop_loss_price := target_low_val
    first_target_price := entry_price + ((entry_price - stop_loss_price) * final_rr_ratio)

if short_entry_cond
    position_state := -1
    entry_price := close
    last_entry_bar := bar_index 
    stop_loss_price := target_high_val
    first_target_price := entry_price - ((stop_loss_price - entry_price) * final_rr_ratio)

// ==============================================================================
// 6. 出場邏輯 (Exit Logic)
// ==============================================================================
bool long_sl_cond = false
bool long_tp_cond = false
bool short_sl_cond = false
bool short_tp_cond = false

// 出場保護：停利 (＄) 必須在進場後的下一根 K 棒才能觸發
bool can_tp = bar_index > last_entry_bar

if position_state == 1
    // 1. 停損 (Hard Stop)
    if low <= stop_loss_price
        long_sl_cond := true
    
    // 2. 停利 (MACD + Min Profit)
    float sl_distance = math.abs(entry_price - stop_loss_price)
    bool has_min_profit = close > (entry_price + sl_distance * 0.5)
    if can_tp and has_min_profit and is_macd_dead_cross_1m
        long_tp_cond := true
        
    if long_sl_cond or long_tp_cond
        position_state := 0
        is_valid_low_setup := false 

if position_state == -1
    // 1. 停損 (Hard Stop)
    if high >= stop_loss_price
        short_sl_cond := true
    
    // 2. 停利 (MACD + Min Profit)
    float sl_distance = math.abs(entry_price - stop_loss_price)
    bool has_min_profit = close < (entry_price - sl_distance * 0.5)
    if can_tp and has_min_profit and is_macd_golden_cross_1m
        short_tp_cond := true
        
    if short_sl_cond or short_tp_cond
        position_state := 0
        is_valid_high_setup := false 

// ==============================================================================
// 7. 視覺化呈現 (Visuals)
// ==============================================================================
plotshape(long_entry_cond, title="Long Entry", style=shape.triangleup, location=location.belowbar, color=col_long_entry, size=size.auto)
plotshape(short_entry_cond, title="Short Entry", style=shape.triangledown, location=location.abovebar, color=col_short_entry, size=size.auto)

plotshape(long_sl_cond, title="Long Stop Loss", style=shape.triangledown, location=location.abovebar, color=col_long_exit, size=size.auto, text="SL", textcolor=col_long_exit)
plotchar(long_tp_cond, title="Long Take Profit", char="＄", location=location.abovebar, color=col_long_exit, size=size.auto, text="TP", textcolor=col_long_exit)

plotshape(short_sl_cond, title="Short Stop Loss", style=shape.triangleup, location=location.belowbar, color=col_short_exit, size=size.auto, text="SL", textcolor=col_short_exit)
plotchar(short_tp_cond, title="Short Take Profit", char="＄", location=location.belowbar, color=col_short_exit, size=size.auto, text="TP", textcolor=col_short_exit)

plot(show_base and is_valid_low_setup and position_state == 0 ? target_low_val : na, title="Target Low", color=col_base_line, style=plot.style_linebr, linewidth=2)
plot(show_base and is_valid_high_setup and position_state == 0 ? target_high_val : na, title="Target High", color=col_base_line, style=plot.style_linebr, linewidth=2)

plot(show_sl and position_state != 0 ? stop_loss_price : na, title="Stop Loss", color=col_sl_line, style=plot.style_linebr, linewidth=1)
plot(show_tp and position_state != 0 ? first_target_price : na, title="First Target", color=col_tp_line, style=plot.style_linebr, linewidth=1)

plot(show_ma ? ma_fast : na, title="Fast MA", color=col_ma_fast, linewidth=2)
plot(show_ma ? ma_slow : na, title="Slow MA", color=col_ma_slow, linewidth=2)


// ==============================================================================
// 8. 資訊面板 (Dashboard)
// ==============================================================================
var string p_pos = panel_pos_str == "Top Right" ? position.top_right : panel_pos_str == "Middle Right" ? position.middle_right : panel_pos_str == "Bottom Left" ? position.bottom_left : panel_pos_str == "Top Left" ? position.top_left : position.bottom_right
var string p_size = panel_size_str == "Tiny" ? size.tiny : panel_size_str == "Small" ? size.small : size.normal

var table panel = table.new(p_pos, 2, 7, bgcolor=color.new(color.black, 80), border_width=1, border_color=color.gray)

if show_table and barstate.islast
    // Header
    table.cell(panel, 0, 0, "5K Strategy Master", text_color=color.white, text_halign=text.align_left, text_size=p_size)
    table.cell(panel, 1, 0, "v2.0", text_color=color.gray, text_halign=text.align_right, text_size=p_size)
    
    // Auto-Detect Status
    string mode_txt = is_auto_active ? "Auto (智能)" : "Manual (手動)"
    color mode_col = is_auto_active ? color.orange : color.gray
    table.cell(panel, 0, 1, "Mode:", text_color=color.white, text_halign=text.align_left, text_size=p_size)
    table.cell(panel, 1, 1, mode_txt, text_color=mode_col, text_halign=text.align_right, text_size=p_size)
    
    table.cell(panel, 0, 2, "Asset:", text_color=color.white, text_halign=text.align_left, text_size=p_size)
    table.cell(panel, 1, 2, asset_class, text_color=color.yellow, text_halign=text.align_right, text_size=p_size)
    
    // Position Status
    string status_txt = position_state == 1 ? "Long (多單)" : position_state == -1 ? "Short (空單)" : "Waiting (等待)"
    color status_col = position_state == 1 ? color.lime : position_state == -1 ? color.red : color.gray
    table.cell(panel, 0, 3, "Status:", text_color=color.white, text_halign=text.align_left, text_size=p_size)
    table.cell(panel, 1, 3, status_txt, text_color=status_col, text_halign=text.align_right, text_size=p_size)
    
    // ATR
    table.cell(panel, 0, 4, "Current ATR:", text_color=color.white, text_halign=text.align_left, text_size=p_size)
    table.cell(panel, 1, 4, str.tostring(atr_val, "#.##"), text_color=color.yellow, text_halign=text.align_right, text_size=p_size)
    
    // 1m MACD
    string macd_txt = macdLine_1m > signalLine_1m ? "Bullish (多)" : "Bearish (空)"
    color macd_col = macdLine_1m > signalLine_1m ? color.lime : color.red
    table.cell(panel, 0, 5, "1m MACD:", text_color=color.white, text_halign=text.align_left, text_size=p_size)
    table.cell(panel, 1, 5, macd_txt, text_color=macd_col, text_halign=text.align_right, text_size=p_size)
    
    // MA Trend
    string trend_txt = is_bull_trend ? "Bullish (多頭)" : "Bearish (空頭)"
    color trend_col = is_bull_trend ? color.lime : color.red
    table.cell(panel, 0, 6, "MA Trend:", text_color=color.white, text_halign=text.align_left, text_size=p_size)
    table.cell(panel, 1, 6, trend_txt, text_color=trend_col, text_halign=text.align_right, text_size=p_size)
