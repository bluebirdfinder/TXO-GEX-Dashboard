import json
import re
from datetime import datetime
from collections import defaultdict
import os

FILE_PATH = r"c:\Users\mingi\OneDrive\文件\TradingView 指標\我寫的指標\5K戰法\ChatExport_2026-05-15\result.json"

def get_multiplier(symbol):
    s = symbol.upper()
    if "BTC" in s: return 0.1
    if "ETH" in s: return 1.0
    if "NQ" in s or "MNQ" in s: return 2.0
    if "ES" in s or "MES" in s: return 5.0
    if "GC" in s or "MGC" in s: return 10.0
    if "CL" in s or "MCL" in s: return 10.0
    if "TX" in s or "MTX" in s: return 10.0
    if "SI" in s: return 10.0 # Micro Silver assumed
    return 1.0

def analyze():
    if not os.path.exists(FILE_PATH):
        print(f"File not found: {FILE_PATH}")
        return

    with open(FILE_PATH, "r", encoding="utf-8") as f:
        data = json.load(f)
        
    messages = data.get("messages", [])
    
    daily_stats = defaultdict(lambda: {"total": 0, "entries": 0, "exits": 0, "profit": 0.0})
    symbol_stats = defaultdict(lambda: {"profit": 0.0, "trades": 0})
    
    for msg in messages:
        if msg.get("type") != "message": continue
        
        # Extract text
        text = ""
        msg_text = msg.get("text", "")
        if isinstance(msg_text, list):
            for part in msg_text:
                if isinstance(part, str): text += part
                elif isinstance(part, dict): text += part.get("text", "")
        else:
            text = str(msg_text)
            
        if not text: continue
        
        # Date
        date_str = msg["date"].split("T")[0]
        
        # Is it a 5K signal?
        if "5K 戰法" not in text: continue
        
        daily_stats[date_str]["total"] += 1
        
        # Parse Entry
        if "進場訊號" in text:
            daily_stats[date_str]["entries"] += 1
            continue
            
        # Parse Exit
        if "出場！" in text:
            daily_stats[date_str]["exits"] += 1
            
            # Extract Symbol
            symbol_match = re.search(r"】([A-Z0-9.!]+)\s*\(", text)
            if not symbol_match: continue
            symbol = symbol_match.group(1)
            
            # Extract Prices
            entry_price_match = re.search(r"進場價：([\d.]+)", text)
            exit_price_match = re.search(r"出場價：([\d.]+)", text)
            
            if entry_price_match and exit_price_match:
                entry_p = float(entry_price_match.group(1))
                exit_p = float(exit_price_match.group(1))
                
                direction = "Long" if "多單" in text else "Short"
                
                multiplier = get_multiplier(symbol)
                diff = exit_p - entry_p if direction == "Long" else entry_p - exit_p
                profit = diff * multiplier
                
                daily_stats[date_str]["profit"] += profit
                symbol_stats[symbol]["profit"] += profit
                symbol_stats[symbol]["trades"] += 1

    # Output Results
    print(f"{'Date':<12} | {'Signals':<8} | {'Exits':<6} | {'Daily P/L':<10}")
    print("-" * 45)
    
    total_profit = 0
    total_days = 0
    total_signals = 0
    
    for d in sorted(daily_stats.keys()):
        s = daily_stats[d]
        print(f"{d:<12} | {s['total']:<8} | {s['exits']:<6} | ${s['profit']:>9.2f}")
        total_profit += s['profit']
        total_signals += s['total']
        total_days += 1
        
    print("-" * 45)
    print(f"Total Profit: ${total_profit:.2f}")
    print(f"Avg Signals/Day: {total_signals/total_days:.2f}" if total_days else "0")
    print(f"Avg Daily P/L: ${total_profit/total_days:.2f}" if total_days else "0")
    
    print("\nProfit by Symbol (Micros):")
    for s in sorted(symbol_stats.keys(), key=lambda x: symbol_stats[x]['profit'], reverse=True):
        stat = symbol_stats[s]
        print(f"{s:<10}: ${stat['profit']:>9.2f} ({stat['trades']} trades)")

if __name__ == "__main__":
    analyze()
